---
/**
 * 日漫排行（R-RANK-01）
 * 数据在 src/config/rankConfig.ts；版式规格见 ARCH.md §5；样式在 src/styles/pages/rank.css
 */
import RankBoard from "@/components/pages/rank/RankBoard.astro";
import { rankConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/rank.css";

const board = rankConfig.boards.jp;

// 榜单数据被删掉时不要让构建炸在页面里，直接跳 404（与模板其它页面一致的做法）
if (!board) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={board.title} description={board.description ?? ""}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
      <RankBoard
        board={board}
        kindLabels={rankConfig.kindLabels}
        dataStatus={rankConfig.dataStatus}
      />
    </div>
  </div>
</MainGridLayout>
