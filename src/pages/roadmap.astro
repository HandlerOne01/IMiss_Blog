---
// src/pages/roadmap.astro
/**
 * 学习路线（R-PATH-01）。设计见 ARCH.md §5；数据见 src/config/roadmapConfig.ts。
 * 纯静态：不挂任何 Svelte island，无 JS 时全部内容都在（prd §6.2）。
 */
import { getCollection, render } from "astro:content";
import PathLine from "@components/pages/roadmap/PathLine.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { type PostLite, resolveRoadmap, roadmapHours } from "@utils/roadmap-utils";
import { roadmapConfig } from "@/config";
import "@/styles/pages/roadmap.css";

const entries = await getCollection("posts", ({ data }) => !data.draft);
const posts: PostLite[] = [];
for (const entry of entries) {
	// entry.id 形如 "linux/git"（glob loader 不带扩展名）
	const [category, ...rest] = entry.id.split("/");
	const { remarkPluginFrontmatter } = await render(entry);
	posts.push({
		category,
		// I3：上屏的是**分类显示名**（面包屑 / `/categories/` 用的就是它），
		// 目录名 `category` 只用来定位文章。
		categoryLabel: entry.data.category || category,
		slug: rest.join("/"),
		title: entry.data.title,
		minutes: Math.max(1, Number(remarkPluginFrontmatter.minutes ?? 1)),
	});
}
const roadmap = resolveRoadmap(roadmapConfig, posts);
// M4 / M7：页顶总时长 = **各线表头小时数之和**（同一个 `lineHours` 口径），不是另算一遍
// `round(totalMinutes / 60)` —— 那样 8 条线加起来 69 而页顶写 68，页面自己跟自己打架。
const hours = roadmapHours(roadmap.lines);
---

<MainGridLayout title="学习路线">
	<div class="roadmap" id="roadmap">
		<header class="roadmap-head">
			<h1 class="roadmap-title">学习路线</h1>
			<p class="roadmap-stats" id="roadmap-stats">
				{roadmap.unique} 篇 · {roadmap.lines.length} 条主线 · {roadmap.stops} 个停靠点（{roadmap.crossCount} 处跨线复用）· 约 {hours} 小时
			</p>
			<nav class="roadmap-index" id="roadmap-index" aria-label="主线索引">
				{/*
					⚠️ `data-no-swup`：页内锚点必须由**浏览器原生**处理（R-PATH-01 实测踩到）。
					Swup 4.9.2 会把这类 `#hash` 链接也拦下来自己处理：URL 确实会带上 hash、也会滚到位，
					但**不写历史记录**（`history.length` 不变）→ 用户按一次后退会直接离开路线页而不是回到页顶；
					而且换页动画没落定的那 ~600ms 里点它会**被整个吞掉**（既不进 URL 也不滚）。
					交给浏览器后：进 URL、进历史、smooth 滚动一起回来，转场期间点也不会丢。
					⚠️ B-16 已把这条规则推广到全站（`astro.config.mjs` 里 swup 的
					`ignore: ['a[href^="#"]:not([href="#"])']`），所以这 8 个属性现在是**冗余但保留**：
					它们仍被 `ignoreVisit` 优先识别（`el.closest('[data-no-swup]')`），
					也仍被 `verify-ui.mjs` 的 R-PATH-01 断言钉着；留着当"这条路径必须原生"的显式标记。
				*/}
				{roadmap.lines.map((line) => <a href={`#line-${line.id}`} data-no-swup>{line.name}</a>)}
			</nav>
		</header>
		{roadmap.lines.map((line) => <PathLine line={line} />)}
	</div>
</MainGridLayout>
