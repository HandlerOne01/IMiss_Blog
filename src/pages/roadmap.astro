---
// src/pages/roadmap.astro
/**
 * 学习路线（R-PATH-01）。设计见 ARCH.md §5；数据见 src/config/roadmapConfig.ts。
 * 纯静态：不挂任何 Svelte island，无 JS 时全部内容都在（prd §6.2）。
 */
import { getCollection, render } from "astro:content";
import PathLine from "@components/pages/roadmap/PathLine.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { type PostLite, resolveRoadmap } from "@utils/roadmap-utils";
import { roadmapConfig } from "@/config";
import "@/styles/pages/roadmap.css";

const entries = await getCollection("posts", ({ data }) => !data.draft);
const posts: PostLite[] = [];
for (const entry of entries) {
	// entry.id 形如 "linux/git"（glob loader 不带扩展名）
	const [category, ...rest] = entry.id.split("/");
	const { remarkPluginFrontmatter } = await render(entry);
	posts.push({
		category,
		slug: rest.join("/"),
		title: entry.data.title,
		minutes: Math.max(1, Number(remarkPluginFrontmatter.minutes ?? 1)),
	});
}
const roadmap = resolveRoadmap(roadmapConfig, posts);
const hours = Math.round(roadmap.totalMinutes / 60);
---

<MainGridLayout title="学习路线">
	<div class="roadmap" id="roadmap">
		<header class="roadmap-head">
			<h1 class="roadmap-title">学习路线</h1>
			<p class="roadmap-stats" id="roadmap-stats">
				{roadmap.unique} 篇 · {roadmap.lines.length} 条主线 · {roadmap.stops} 个停靠点（{roadmap.crossCount} 处跨线复用）· 约 {hours} 小时
			</p>
			<nav class="roadmap-index" id="roadmap-index" aria-label="主线索引">
				{roadmap.lines.map((line) => <a href={`#line-${line.id}`}>{line.name}</a>)}
			</nav>
		</header>
		{roadmap.lines.map((line) => <PathLine line={line} />)}
	</div>
</MainGridLayout>
