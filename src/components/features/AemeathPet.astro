---
/**
 * 桌宠「爱弥斯」（R-PET-01 ~ R-PET-10）
 * ============================================================================
 * 素材：`src/assets/images/pet/pet-aemeath.webp`（8 列 × 9 行，单格 144×156）
 *   Codex 自定义宠物图集（MIT），九行 = 九个状态。
 * 行为：从原型 `my_-blog/blog_test` 的 `assets/js/pet.js` 移植（那份是验证过的实现），
 *   按本站的钩子重接：主题切换用模板的 `theme-change` 事件、切页用 Swup 的
 *   `astro:page-load`、阅读页安静模式按 pathname 判断。
 * 运动（R-PET-06）：三档 `petConfig.movement.mode` ——
 *   `fixed`（**默认**，发起人 2026-10-02 改：「这小人待机时会移动，别让它移动」）
 *   固定不动 · `float` 悬浮 + 偶尔飞行 · `ground` 贴地行走。
 *   ⚠️ 三档都还在、都还能用（改配置或 `__imissSetMode()` 切）——只是默认档换了。
 *   悬浮的上下浮动**由 rAF 逐帧写 transform**（不用 CSS animation：CSS 动画的
 *   位移优先级和 JS 写的 `translate3d` 会互相覆盖，拖拽与位置记忆会打架）。
 * 样式：`src/styles/pet.css`（**不是**组件的 scoped style —— JS 动态创建的星屑节点
 *   拿不到 Astro 的 scope 属性，样式会静默失效，见该文件头注释）。
 *
 * ⚠️ R-PET-12 / R-PET-13（发起人 2026-10-08，手机端"看不见她"那一轮）：
 *   ① **手机端显示**：`hideOnMobile` 由 true 改 false，并在 `pet.css` 里补上真正的手机档缩放。
 *      原来那段媒体查询是**死的** —— 组件内联写 `--pet-scale`，内联变量赢过媒体查询，
 *      手机拿到的一直是桌面档。现在组件只内联"桌面档 / 手机档 / mini 系数"三个值，
 *      由 CSS 决定哪个生效（详见 `pet.css` 顶部那段注释）。
 *   ② **菜单改版**：删「说句话」入口、「和爱弥斯聊天」提到第一项、末项变「缩小」（v1.69 改的字面，
 *      之前叫「关闭」—— 名字不准，她没被关掉）；
 *      缩小 = 缩成很小一只（`miniFactor`，比待机还小），双击她本體恢复。
 *      迷你期间**闭嘴**（不气泡、不自动活动、不进待机画面）—— 她要的就是"降到最低存在感"。
 *
 * ⚠️ R-PET-10（发起人 2026-09-26 第四轮反馈，两张图）踩到的两件事，改动集中在这两处：
 *   ① 「**点击落下去之后没有真的落下去啊**」——「落下去」= `setMode("ground", smooth)`，
 *      它只是把 `airborne` **立起来**，真正让宠物掉下去的是 `step()` 里的重力积分，
 *      而 `step()` 只在 rAF 循环里跑。两条路径会让"立起来的下落"永远不落地：
 *        · 聊天框开着 → 原来 `step()` 在重力分支**之前** `if (pet.dragging || chatOpen) return;`
 *          （已改为只挡拖动，闸门挪到重力之后）；
 *        · `prefers-reduced-motion: reduce` → `start()` 按设计**根本不开 rAF 循环**
 *          （已在 `startFall()` 里直接落到地面线）。
 *      两条都在真机上复现过（y 连续 1.5s 一动不动、离地 370px），见 §14.3 T45/T46。
 *   ② 「**聊天的时候小人抖动太快了**」——聊天播的是 `running`（row7 戴墨镜），
 *      原来 12fps（83ms/帧）比待机呼吸还快一倍；帧率表与"语气/待机类 ≥ 200ms"这条下限
 *      见 `src/utils/pet-utils.ts` 的 `PET_STATES` / `PET_MOOD_STATES`（R-PET-10）。
 *
 * 为什么挂在这里能跨页常驻：Layout 是 Swup 的宿主页，本组件渲染在 Swup 的
 * 6 个替换容器**之外**，切页时节点不重建（ARCH.md §7.2 / §14.3 T10）。
 * ============================================================================
 */
import { petConfig } from "@/config";
import "@/styles/pet.css";

const {
	enable,
	hideOnMobile,
	mobileBreakpoint,
	scale,
	mobileScale,
	miniFactor,
	zIndex,
	movement,
} = petConfig;

/**
 * 解析期的"这台设备要不要桌宠"判断（R-PET-01）。
 * 写成 frontmatter 里的字符串再 set:html，而不是把表达式塞进内联 script 标签里 ——
 * 后者在 `is:inline` 下不会被当成 Astro 表达式处理（实测：变量没被插值，
 * 而且 TS 还会报"变量声明未使用"）。
 * ⚠️ 这里**不许写出那个标签的字面量**（尖括号 + script）：Vite 8 的依赖预打包扫描器会把
 *    .astro 注释里的它当成真的脚本块开始标记，把后面这串中文注释当 JS 解析 →
 *    `PARSE_ERROR` → 整轮 `Skipping dependency pre-bundling` → dev 的模块请求卡到 60 秒超时
 *    （2026-10-08 实测，见 `ARCH.md` §14.3 **T89**）。
 */
/*
 * 右键菜单里「落下去 / 飘起来」两项的语义（R-PET-09 起只剩这两项）：
 *   落下去 = 切到贴地档但**不瞬移**（复用拖动松手那条重力路径落到底，startFall）；
 *   飘起来 = 反向回到悬浮档（复用 startFlight 的缓动插值竖直飘上悬浮基准线）。
 *   悬浮/固定档显示「落下去」，贴地档显示「飘起来」，否则落下去就回不来了。
 * ⚠️ 这段说明原先写在模板的 JSX 注释里 —— 模板注释会**原样进产物**（T85），
 *    已挪到 frontmatter（构建期用，不进产物）。
 * ⚠️ 写这类说明时**别把注释的起止定界符写进正文**：本轮就因为在块注释里写了那对定界符，
 *    让注释提前闭合、Astro 编译器报 `Unexpected token`（T88 第二次复发，2026-10-08）。
 */
const petHideScript = `(function(){try{if(${hideOnMobile}&&window.matchMedia("(max-width: ${mobileBreakpoint - 1}px)").matches){document.documentElement.dataset.petOff="1";}}catch(e){}})();`;
---

{
	enable && (
		<>
			{/* 解析期就决定"这台设备要不要桌宠"：移动端隐藏时连脚本都不启动（R-PET-01）。
			    用 html 上的标记而不是 hidden 属性，理由同排行榜面板（ARCH §14.3 T24）。 */}
			<script is:inline set:html={petHideScript} />

			<div
				class="pet"
				id="pet"
				data-pet
				data-pet-mode={movement.mode}
				data-pet-mini="0"
				style={`--pet-scale-desktop:${scale};--pet-scale-mobile:${mobileScale};--pet-mini-factor:${miniFactor};z-index:${zIndex}`}
			>
				<p class="pet-bubble" id="pet-bubble" role="status" aria-live="polite"></p>
				<span
					class="pet-body"
					id="pet-body"
					role="button"
					tabindex="0"
					aria-label="桌宠爱弥斯：点一下会跳起来，可以拖着走，左右方向键也能指挥它；按回车和我说话"
				>
					<span class="pet-shadow" aria-hidden="true"></span>
					<span class="pet-sprite" id="pet-sprite" aria-hidden="true"></span>
				</span>
			</div>

			{/* 右键菜单用真实 DOM 渲染（不是 JS 现拼），读屏与键盘都能用。
			    ⚠️ R-PET-07：**必须给 z-index**（宠物 zIndex + 1）。原来没有 z-index（= auto = 0），
			    而模板里 `#wallpaper-wrapper` 是 z-index 10、`#content-panel` 是 30 —— 菜单被画在
			    壁纸和正文面板**下面**，只在两者都盖不到的地方露出来（实测 elementFromPoint 命中的
			    是壁纸 <img> 而不是菜单），看起来就是"菜单缺了一块/被裁掉一半"。
			    67 仍然远低于浮动按钮（1000）与移动端菜单面板（1100），R-PET-05 的"低于浮动控件"不受影响。
			    ⚠️ R-PET-08 的另一半：层级只负责"不被常驻层压住"，**不负责"不被遮挡"** ——
			    摆位的最后一关是 `placeMenu()` 里的 `elementFromPoint` 抽样（见该函数注释）；
			    这里是"换边躲开遮挡"，不是"抬高 z-index 压过去"。

			    菜单项（R-PET-08 / R-PET-09 / R-PET-13）：
			      和爱弥斯聊天 ·「落下去」/「飘起来」（按当前档位二选一显示）· 缩小
			    发起人三轮反馈的增删：
			      · R-PET-08：「（跟过来、睡一会儿）**这两个没有鸟用啊**」→ 两个入口删除，
			        `walkTo()` 与 `waiting` **本体都还在用**（键盘 ←/→ 走 `walkTo()`；
			        45 秒无操作超时进 `waiting`），所以只删入口、不删能力。
			      · R-PET-09：「**还有跳一跳的功能也删了，左键点击就能跳所以按键没有必要**」→
			        「跳一下」入口删除（`jump()` 本体还在：左键单击与键盘 Enter 都调它）。
			      · R-PET-13（本轮）：「**把说句话交互删掉，然后把和爱弥斯聊天放在第一个，
			        然后最后一个变成关闭**」→ 删「说句话」入口（`say()` 本体仍在：左键单击、
			        键盘 Enter、切档、出场问候都调它）；聊天提到第一项；
			        新增末项 = 缩小成很小一只（`setMini(true)`，双击恢复）。
			        该项**文案随状态变**（正常「缩小」（v1.69 前写作「关闭」）/ 迷你「叫醒她」），
			        由 `syncMenuMode()` 写。
			    「落下去」/「飘起来」**两个按钮都渲染**（不是条件渲染）：切档时只翻 `hidden`，
			    不用重建节点；谁显示谁隐藏由 `syncMenuMode()` 按 `pet.mode` 决定。 */}
			<div
				class="pet-menu"
				id="pet-menu"
				role="menu"
				aria-label="和爱弥斯互动"
				style={`z-index:${zIndex + 1}`}
				hidden
			>
				<button type="button" role="menuitem" data-pet-act="chat">
					和爱弥斯聊天
				</button>
				{/* 落下去 / 飘起来 的语义见文件头 frontmatter 注释（模板注释会进产物，T85） */}
				<button type="button" role="menuitem" data-pet-act="drop">
					落下去
				</button>
				<button type="button" role="menuitem" data-pet-act="rise">
					飘起来
				</button>
				<button type="button" role="menuitem" data-pet-act="mini" aria-pressed="false">
					缩小
				</button>
			</div>
		</>
	)
}

<script>
	import { petConfig } from "@/config";
	import { askAemeath, classifyAsk, resetSession, type AgentTurn } from "@/utils/agent-client";
	import { cleanMarkdown, cleanUserText, formatClock, shouldCollapse } from "@/utils/pet-chat-text";
	import {
		PET_COLS,
		PET_FLIGHT_POSE,
		PET_ROWS,
		PET_STATES,
		PET_TUNING,
		type PetStateName,
	} from "@/utils/pet-utils";
	import type { PetMovementMode } from "@/types/petConfig";

	(function () {
		const root = document.documentElement;
		// 幂等守卫：无论什么原因重复执行，都只初始化一次
		if ((window as Window & { __imissPetReady?: boolean }).__imissPetReady) return;
		(window as Window & { __imissPetReady?: boolean }).__imissPetReady = true;

		// 移动端隐藏：解析期已经打了标记，这里直接不启动
		if (root.dataset.petOff === "1") return;

		const el0 = document.getElementById("pet");
		const hit0 = document.getElementById("pet-body");
		const sprite0 = document.getElementById("pet-sprite");
		const bubble0 = document.getElementById("pet-bubble");
		const menu0 = document.getElementById("pet-menu");
		if (!el0 || !hit0 || !sprite0 || !bubble0 || !menu0) return;
		// 收窄后再绑定成新常量：闭包里引用它们时类型才稳定是 HTMLElement（不然 ts(18047)）
		const el: HTMLElement = el0;
		const hit: HTMLElement = hit0;
		const sprite: HTMLElement = sprite0;
		const bubble: HTMLElement = bubble0;
		const menu: HTMLElement = menu0;
		// R-PET-08：「落下去」/「飘起来」按档位二选一显示，同步在 syncMenuMode() 里
		const dropItem = menu.querySelector<HTMLElement>('[data-pet-act="drop"]');
		const riseItem = menu.querySelector<HTMLElement>('[data-pet-act="rise"]');
		// R-PET-13：菜单末项「关闭 / 叫醒她」（开合项，文案由 syncMenuMode() 写）
		const miniItem = menu.querySelector<HTMLElement>('[data-pet-act="mini"]'); // 文案：「缩小」/「叫醒她」

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const PET_KEY = "imiss.pet.pos";
		/**
		 * `review`（完成反馈）一次性动画的播放时长（R-PET-10）
		 * ============================================================================
		 * ⚠️ 这个数与 `PET_STATES.review` 的帧率是**绑死的**：6 帧 × 250ms = 1500ms。
		 * `review` 是 `once` 状态，`setState()` 用 `busyUntil` 计时，到点后 `step()` 会
		 * 无条件 `setState("idle")` —— 所以 hold 比"帧数 × 帧间隔"短的话，动画会在播完前
		 * 被切掉（R-PET-10 把 review 从 9fps 放到 4fps 时，原来写死的 900ms 就只够播 3.6 帧）。
		 * 改 `review` 的 fps 或 frames 时**必须同步改这里**（断言里有一条专门卡这个口径）。
		 */
		const REVIEW_HOLD = 1500;
		const COLS = PET_COLS;
		const ROWS = PET_ROWS;
		const {
			gravity,
			walkSpeed,
			floorGap,
			edge,
			workLinger,
			safeRight,
			hoverLineRatio,
			airMinGap,
			glideSpeedFactor,
			flyDistanceRange,
			flyVerticalRatio,
			flyArc,
			flyTilt,
			flyZoom,
			menuGap,
			menuMargin,
		} = PET_TUNING;
		const MV = petConfig.movement;
		const sleepAfter = petConfig.idleSecondsToSleep * 1000;

		/** 本次会话的运动模式：**只认配置**（位置记忆里存的模式不覆盖它，见 ARCH.md §7.6） */
		const MODE: PetMovementMode = MV.mode;
		/** 悬浮/飞行时是否要停（reduced-motion 且配置要求尊重它时） */
		const flyBlocked = reduce && MV.flyRespectReducedMotion;

		let vw = 0;
		let vh = 0;
		let floorY = 0;
		let w = 0;
		let h = 0;
		let footPx = 0;
		let raf = 0;
		let last = 0;
		let drag: {
			id: number;
			dx: number;
			dy: number;
			moved: number;
			x0: number;
			y0: number;
		} | null = null;
		let moveAcc = 0;
		let sayTimer = 0;
		let lastLine = -1;
		let workTimer = 0;
		let chatOpen = false;

		/* ── 对话接线（R-AGT-03 / R-AGT-04，P5-1 / P5-2 / P5-3；R-PET-11 重做 UI）─
		   ⚠️ 五个会话变量**各管一件事**，别合并（合并过一次，结果是"关了聊天框
		      还会把答复写进气泡"这类只在真机上出现的错位）：
		     · `chatSession`  —— 第几次开聊天框。每次 `openChat()`/`closeChat()` 都 +1，
		        异步回调回来时先比它，**不是当前这一轮就整个丢掉**（切页 / 关框后不写气泡）。
		     · `chatBusy`     —— 这一轮请求还在飞（防连点、给输入框上锁）。
		     · `chatAsk`      —— 上一轮后端反问的那句原文（判"用户这句是不是在回答它"）。
		     · `chatResume`   —— 用户明确说了约定词（不提供/需要/不需要）时，下一轮该回的话。
		     · `chatAbort`    —— 关框 / 切页时掐掉已发出的流。
		   ⚠️ R-PET-11 把"思考中的兜底计时器"（`thinkTimer`，原来 1200ms 补写一次占位文本）
		      换成了 `thinkRotateTimer`：占位文本**不再写进答复元素**，而是画在独立的
		      `.pet-chat-thinking` 上（轮换短句 + 动画省略号），所以不需要"补写"，只需要
		      "轮换"；它的清理仍然在 `clearChatRuntime()` / `endTrip()` 两处（缺一处就会
		      出现"框关了，思考句还在轮换"的隐形定时器）。 */
		let chatSession = 0;
		let chatBusy = false;
		let chatAsk: string | null = null;
		let chatResume: string | null = null;
		let chatAbort: AbortController | null = null;
		let thinkRotateTimer = 0;
		let stateTimer = 0;
		/** 输入框里已经填过的上一位"爱弥斯说的话"（判约定词用；`closeChat()` 清空） */
		let lastReply = "";
		/**
		 * 这一轮还在飞的时候用户又按了发送（P5 复核 D-9）。
		 * 旧实现是 `if (!text || chatBusy) return;` —— **静默吞掉**：字留在输入框里、
		 * 气泡没动静，用户看到的是"按了没反应"（复核实测连点 4 次，输入框内容一路累积到 24 字）。
		 * 现在：留着用户那句话不清（不丢他的输入）＋ 给一句可见反馈，等这一轮落地后提醒他重发。
		 */
		let chatPendingRetry = false;
		/** 后端反问时气泡里除了询问原文还会补这一行（人设口径，且不含任何内部信息） */
		const INTERRUPT_HINT = "回我「不提供」也行，我替你挑。";
		/** 忙的时候用户又按发送给的反馈（人设口径：不说"请求/服务/稍后再试"这类字样） */
		const BUSY_HINT = "……我这儿还忙着上一句呢，等我落地你再发一次。";
		/** 清空对话后的那一句（不是报错，是"我听见了"） */
		const CLEAR_NOTICE = "……行，刚才那些我不提了，重新说。";
		/** 后端反问句最多显示多少字（面板宽 340px，太长会顶到视口外；截断只发生在极长句上） */
		const ASK_MAX_CHARS = 220;

		/* ── 聊天框的历史与 DOM 句柄（R-PET-11）───────────────────────────
		   `chatLog` 是**这次页面会话**的对话历史：关框、再开、Swup 切页都留着
		   （理由与边界见 ARCH.md §7.6 的 R-PET-11 段）。
		   ⚠️ 它是**唯一事实来源**：DOM 每次开框都按它重建，所以"关框再开续上"不需要
		      额外同步逻辑，也不会出现"DOM 里多了一条、数组里没有"的错位。 */
		interface ChatLine {
			role: "user" | "ai" | "notice";
			text: string;
			at: number;
		}
		const CHAT = petConfig.chat;
		let chatLog: ChatLine[] = [];
		let chatList: HTMLElement | null = null;
		let chatThink: HTMLElement | null = null;
		let chatThinkText: HTMLElement | null = null;
		let chatRecv: HTMLElement | null = null;
		let chatInput: HTMLInputElement | null = null;
		let chatSend: HTMLButtonElement | null = null;
		let chatJump: HTMLButtonElement | null = null;
		/**
		 * 流式增量**只在这里攒着，一个字都不上屏**（R-PET-11 的核心选择）。
		 * 发起人的图证就是"半截答案实时刷屏"（`SDD？ 你说的是 Spec-Driven Development？ 还是…`），
		 * 用户看不出"它在想"还是"它答完了"；而且 Markdown 的 `**` 在流式途中会先露一半
		 * （图证里 `**规范驱动开发**` 的星号就是这么漏出来的）。所以：
		 *   思考中 → 只显示"思考中"指示 + **已收到的字数**（不含正文）；完成 → 整段清洗后一次上屏。
		 */
		let chatStreamBuf = "";
		/** 「思考中」轮换短句的下标（-1 = 还没选过） */
		let thinkIdx = -1;
		/** ↑/↓ 翻自己说过的话：-1 = 不在翻历史 */
		let histIdx = -1;

		const pet = {
			x: 0,
			y: 0,
			vy: 0,
			state: "idle" as PetStateName,
			frame: 0,
			acc: 0,
			face: 1 as 1 | -1,
			walking: false,
			targetX: 0,
			airborne: false,
			dragging: false,
			nextAt: 0,
			busyUntil: 0,
			asleep: false,
			lastActive: 0,
			cursorX: 0,
			px: -1,
			py: -1,
			lastClick: 0,
			userMoved: false,
			/** 本次播放是否把 `once` 状态改成循环（R-PET-07，目前只给飞行姿态用） */
			poseLoop: false,
			/** 当前运动模式（R-PET-06），运行期可被 `__imissSetMode()` 改（验收脚本用） */
			mode: MODE,
			/**
			 * 「关闭」档是否生效（R-PET-13）：true = 缩成很小一只 + 闭嘴 + 不自动活动。
			 * 它**不是** `enable: false` —— 节点一直在，双击就回来（见 `setMini()`）。
			 */
			mini: false,
			/** 悬浮基准线（宠物中心不摆动时的 y）；拖放 / 飞行落位 / 缩放后重新锚定 */
			hoverBase: 0,
			/** 悬浮相位（弧度，逐帧累加）：重新锚定时归零，正弦正好为 0 → 不跳变 */
			hoverPhase: 0,
			/** 正在进行的飞行（null = 没在飞）：起点 → 终点 + 弧线 + 时长 */
			flight: null as null | {
				x0: number;
				y0: number;
				x1: number;
				y1: number;
				arc: number;
				startAt: number;
				dur: number;
			},
		};

		/* ── 量尺寸 ─────────────────────────────────────── */
		/**
		 * 右侧"让给浮动按钮"的宽度（R-PET-05）。
		 * 返回顶部按钮是滚下去才出现的，所以**不能只看它当前是否可见**——
		 * 第一版就是这么写的：出场时按钮还没显示（宽 0 → 跳过），
		 * 等滚到下面按钮冒出来，宠物正好压在它上面（实测 1416 > 1409）。
		 * 现在按固定预留算，按钮真可见时再用它的实际位置收窄一次。
		 *
		 * ⚠️ R-PET-06：收窄的判据从"地面高度"改成**传进来的纵向位置**——
		 * 悬浮模式下宠物可能停在视口任意高度，继续拿 `floorY` 判断的话，
		 * 它在半空中飞到按钮正上方就不会被收窄了。
		 */
		const FLOAT_RESERVE = 64;

		function rightLimit(yTop: number = pet.y): number {
			let limit = vw - w - safeRight - FLOAT_RESERVE;
			// 纵向留一层自身高度的余量：飞行途中的中间帧也不许压上按钮
			const pad = h;
			for (const node of document.querySelectorAll<HTMLElement>(
				"#back-to-top-btn, .floating-controls-container",
			)) {
				const r = node.getBoundingClientRect();
				if (r.width === 0 || r.height === 0) continue;
				if (r.bottom < yTop - pad || r.top > yTop + h + pad) continue;
				limit = Math.min(limit, r.left - w - 12);
			}
			return Math.max(edge, limit);
		}

		function clampX(x: number, yTop: number = pet.y): number {
			return Math.max(edge, Math.min(rightLimit(yTop), x));
		}

		/** 悬浮 / 飞行时的纵向范围：不出视口顶部，且**离地至少 `airMinGap`**（"不贴地"的硬约束） */
		function minAirY(): number {
			return edge;
		}

		function maxAirY(): number {
			return Math.max(minAirY(), floorY - airMinGap);
		}

		function clampAirY(y: number): number {
			return Math.max(minAirY(), Math.min(maxAirY(), y));
		}

		/** 拖动 / 固定模式的纵向范围：只要整体留在视口内 */
		function clampY(y: number): number {
			return Math.max(0, Math.min(Math.max(0, vh - h), y));
		}

		/** 悬浮基准线：视口 `hoverLineRatio` 处（宠物中心），并夹到"不贴地、不出屏"的范围里 */
		function floatBaseY(): number {
			return clampAirY(vh * hoverLineRatio - h / 2);
		}

		/** 两次飞行之间的随机间隔（毫秒）；阅读页拉长 2.5 倍——安静模式仍然会飘，只是很少 */
		function nextFlyDelay(): number {
			const lo = Math.max(1000, MV.flyIntervalRange[0]);
			const hi = Math.max(lo, MV.flyIntervalRange[1]);
			const base = lo + Math.random() * (hi - lo);
			return root.dataset.petRoute === "post" ? base * 2.5 : base;
		}

		function measure(): void {
			vw = window.innerWidth;
			vh = window.innerHeight;
			w = sprite?.offsetWidth || 144;
			h = sprite?.offsetHeight || 156;
			footPx = h * (152 / 156);
			floorY = vh - floorGap - footPx;
			if (pet.airborne) return;
			pet.x = clampX(pet.x);
			pet.targetX = clampX(pet.targetX);
			// 各模式收到尺寸变化后的"落点"不同：贴地 → 地面；悬浮 → 重新锚定基准线；固定 → 只夹回视口
			if (pet.mode === "ground") {
				pet.y = floorY;
			} else if (pet.mode === "float") {
				if (!pet.flight) {
					pet.hoverBase = clampAirY(pet.hoverBase || pet.y);
					pet.hoverPhase = 0;
					pet.y = pet.hoverBase;
				}
			} else {
				pet.y = clampY(pet.y);
			}
		}

		/** 默认出场位置：贴着自己那一侧，但**永远避开右下角的浮动按钮区**（R-PET-05） */
		function defaultX(): number {
			const side =
				petConfig.startSide === "random" ? (Math.random() < 0.5 ? "left" : "right") : petConfig.startSide;
			if (side === "left") return edge + 8;
			return clampX(vw - w - safeRight - FLOAT_RESERVE);
		}

		/* ── 状态与帧 ───────────────────────────────────── */
		/**
		 * `loop`（R-PET-07）：把"一次性动画"（`PET_STATES[name].once`）在本次播放里改成循环。
		 * 目前只有飞行姿态用它 —— 飞行借的是 `jumping`（图集 row4，双臂张开的唯一"悬空"形状），
		 * 而 `jumping` 本来是播完就停在末帧的一次性动画，飞行有 4~6 秒，冻帧会显得很呆。
		 * 不传就复位成 `false`，所以"飞行结束 → setState("idle")"这条路径天然把循环关掉。
		 */
		function setState(name: PetStateName, holdMs = 0, loop = false): void {
			const s = PET_STATES[name];
			pet.poseLoop = loop;
			if (pet.state === name) {
				if (s.once) pet.busyUntil = performance.now() + holdMs;
				return;
			}
			pet.state = name;
			pet.frame = 0;
			pet.acc = 0;
			sprite?.style.setProperty("--pet-dy", `${s.dy ?? 0}px`);
			pet.busyUntil = s.once ? performance.now() + holdMs : 0;
			el?.setAttribute("data-pet-state", name);
			// R-PET-10：把**当前状态的帧间隔**也写进 DOM（毫秒，四舍五入）。
			// 为什么要暴露：帧率下限（语气/待机类 ≥ 200ms）是"看不见的规格"，
			// 只有写出来才能在真机里断言"此刻正在播的那一帧序列确实够慢"——
			// verify:ui 的 R-PET-10 会同时用 DOM 属性与 `backgroundPosition` 的时间戳两条证据核。
			el?.setAttribute("data-pet-frame-ms", String(Math.round(1000 / s.fps)));
			pet.px = -1; // 逼 draw() 立刻重画一帧（reduced-motion 下没有 rAF 循环）
			draw(0);
		}

		function setFace(f: 1 | -1): void {
			if (pet.face === f) return;
			pet.face = f;
			sprite?.style.setProperty("--pet-face", String(f));
		}

		/* ── 运动模式（R-PET-06）─────────────────────────────
		   float：悬浮（正弦上下浮动）+ 偶尔飞行；fixed：一动不动；ground：贴地行走。
		   三种模式的差别只落在三件事上：y 怎么来、有没有重力、计时器到点做什么。 */
		function applyTransform(): void {
			el?.style.setProperty("transform", `translate3d(${pet.x.toFixed(2)}px,${pet.y.toFixed(2)}px,0)`);
		}

		/** 飞行姿态：倾斜 + 轻微放大（`k = sin(πt)`，两端为 0 = 中性姿态，不突变） */
		function setFlyPose(k: number, dir: 1 | -1): void {
			sprite?.style.setProperty("--pet-tilt", `${(dir * flyTilt * k).toFixed(2)}deg`);
			sprite?.style.setProperty("--pet-fly-scale", (1 + flyZoom * k).toFixed(4));
		}

		function clearFlyPose(): void {
			sprite?.style.setProperty("--pet-tilt", "0deg");
			sprite?.style.setProperty("--pet-fly-scale", "1");
		}

		/** 中断本次飞行（用户一动手就停，R-PET-06），并把悬浮基准线锚到当前位置 */
		function cancelFlight(rearm = true): void {
			if (!pet.flight) return;
			pet.flight = null;
			el?.removeAttribute("data-pet-flying");
			clearFlyPose();
			pet.hoverBase = clampAirY(pet.y);
			pet.hoverPhase = 0;
			if (rearm) pet.nextAt = performance.now() + nextFlyDelay();
			placeMenu(); // 飞行被打断也可能换了位置 → 菜单跟着重排（菜单没开时是空操作）
		}

		/**
		 * 起飞一次。`force` 只给调试钩子 `__imissFlyNow()` 用（跳过"睡着"判断），
		 * 其余判断与自动飞行完全一致 —— 验收脚本测的是**飞行函数本身**，不是绕过它。
		 *
		 * `dest`（R-PET-08）：**显式目标点**，只给菜单「飘起来」用 —— 从贴地档回到悬浮档时
		 * 竖直飘上悬浮基准线。带了它就不摇随机方向，直接往那个点插值（x 不动）。
		 *
		 * ⚠️ R-PET-07 改了目标点的取法：原来是"在**整个视口**里随机取一个点"
		 * （实测单次位移 414~550px，发起人反馈："你飞的太快了……自然一点就**微微挪动**就好了"）。
		 * 现在是"**以当前位置为圆心**、朝随机方向挪 `flyDistanceRange`（60~180px）"，
		 * 纵向再按 `flyVerticalRatio` 压扁 —— 观感是"轻轻挪了一下"，而不是"瞬移到别处"。
		 * 目标点仍然先过 `rightLimit(y1)`（右下角浮动按钮，R-PET-05）、飞行中逐帧再 clamp
		 * （不出视口）；夹回后位移缩水太多就重摇，摇几次都不行就这次不飞（过一会儿再试）。
		 */
		function startFlight(now: number, force = false, dest?: { x: number; y: number }): boolean {
			if (pet.mode !== "float" || pet.dragging || chatOpen || pet.flight) return false;
			if (flyBlocked) return false; // reduced-motion：只保留静态悬浮，不飞
			if (pet.asleep && !force) return false;
			if (force) wake();

			let x1 = pet.x;
			let y1 = pet.y;
			if (dest) {
				// 显式目标（菜单「飘起来」）：不摇随机方向，只把目标夹回既有约束
				x1 = clampX(dest.x, dest.y);
				y1 = clampAirY(dest.y);
			} else {
				const [distLo, distHi] = flyDistanceRange;
				const minDist = Math.max(1, distLo);
				let best = -1;
				// 最多摇 6 次：随机方向可能正好指向视口外或浮动按钮区，clamp 之后位移会缩水
				for (let i = 0; i < 6; i++) {
					const dist = minDist + Math.random() * Math.max(0, distHi - minDist);
					const ang = Math.random() * Math.PI * 2;
					const ty = pet.y + Math.sin(ang) * dist * flyVerticalRatio;
					const cx = clampX(pet.x + Math.cos(ang) * dist, ty);
					const cy = clampAirY(ty);
					const d = Math.hypot(cx - pet.x, cy - pet.y);
					if (d > best) {
						best = d;
						x1 = cx;
						y1 = cy;
					}
					if (d >= minDist) break; // 已经达到下界，够"看得出挪了"
				}
				// 摇了 6 次都被夹到"几乎没动"（贴边/贴按钮的极端位置）→ 这次不飞，过一会儿再试
				if (best < minDist * 0.5) {
					pet.nextAt = now + 3000;
					return false;
				}
			}
			const [durLo, durHi] = MV.flyDurationRange;
			const dur = Math.max(1000, durLo + Math.random() * Math.max(0, durHi - durLo));
			pet.walking = false;
			pet.busyUntil = 0;
			pet.flight = {
				x0: pet.x,
				y0: pet.y,
				x1,
				y1,
				arc: flyArc * (0.6 + Math.random() * 0.8), // 每次弧线高度不同，不至于像流水线
				startAt: now,
				dur,
			};
			el?.setAttribute("data-pet-flying", "1");
			// 飞行姿态：图集里没有"飞"行，借最像悬空的 row4（jumping，双臂平展）并循环播放
			setState(PET_FLIGHT_POSE.state, 0, PET_FLIGHT_POSE.loop);
			// 姿态是"循环的飞行帧"，不能被一次性动画的收尾逻辑（step 里的 busyUntil 分支）接管
			pet.busyUntil = 0;
			return true;
		}

		function advanceFlight(now: number): void {
			const f = pet.flight;
			if (!f) return;
			const t = Math.min(1, (now - f.startAt) / f.dur);
			// 缓入缓出（easeInOutSine，R-PET-07 从 easeInOutQuad 换过来）：
			// 起步与收尾更平，几乎看不出"启动/刹车" —— 配合 60~180px 的小位移就是"轻轻飘一下"
			const e = -(Math.cos(Math.PI * t) - 1) / 2;
			const arc = f.arc * Math.sin(Math.PI * t); // 中途抬起一点，直线插值看起来才像"飘"
			const x = f.x0 + (f.x1 - f.x0) * e;
			const y = f.y0 + (f.y1 - f.y0) * e - arc;
			// 逐帧也守约束：飞行途中按钮冒出来 / 窗口缩小，都不会压上按钮或飞出视口
			pet.x = clampX(x, y);
			pet.y = clampAirY(y);
			setFlyPose(Math.sin(Math.PI * t), f.x1 >= f.x0 ? 1 : -1);
			if (menu && !menu.hidden) placeMenu(); // 菜单开着时跟着宠物走（没开就是空操作）
			if (t >= 1) {
				pet.x = clampX(f.x1, f.y1);
				pet.y = f.y1;
				endFlight(now);
			}
		}

		function endFlight(now: number): void {
			pet.flight = null;
			el?.removeAttribute("data-pet-flying");
			clearFlyPose();
			// 落位后**就在落点继续悬浮**（不弹回原来的高度），再排下一次飞行
			pet.hoverBase = clampAirY(pet.y);
			pet.hoverPhase = 0;
			pet.nextAt = now + nextFlyDelay();
			setState("idle"); // 从飞行姿态回到待机（顺带把 poseLoop 复位）
			savePos();
			placeMenu();
			placeChat(); // 宠物落位了 → 聊天框重新贴回它旁边（R-PET-11：飞行途中不跟，落位再跟）
		}

		/** 悬浮：绕基准线做正弦上下浮动（rAF 逐帧，理由见文件头） */
		function hoverStep(dt: number): void {
			const period = Math.max(400, MV.hoverPeriodMs);
			pet.hoverPhase += (dt * 1000 * Math.PI * 2) / period;
			if (pet.hoverPhase > Math.PI * 2) pet.hoverPhase -= Math.PI * 2;
			pet.y = clampAirY(pet.hoverBase + Math.sin(pet.hoverPhase) * MV.hoverAmplitude);
		}

		/**
		 * 让宠物从**当前高度受重力落到地面**（R-PET-08，菜单「落下去」）
		 * ============================================================================
		 * 「复用」是字面意思：重力积分那段**就是** `step()` 里贴地档的
		 * `pet.mode === "ground" && pet.airborne` 分支（P3 起就在跑），这里只把
		 * "松手落地"的起手两行（`airborne = y < floorY - 2`、`vy = 60`）抽成公共入口，
		 * 于是**拖动松手**（`onPointerUp`）与**菜单「落下去」**走的是同一条下落路径 ——
		 * 逐帧加速度、落地判定（`y >= floorY && vy >= 0`）、撞击回弹（`impact > 1100`
		 * 时弹一下）全部照旧，没有第二套缓动/插值。
		 * 唯一多出来的一点：下落途中借 `PET_FLIGHT_POSE`（图集 row4，"双臂张开、双脚离地"，
		 * 也是飞行用的那个姿态）**循环播放** —— 悬空时用站姿帧看起来像"平移"而不是"掉下来"；
		 * 落地那一帧 `step()` 自己会 `setState("jumping", 420)` 播落地的弹跳。
		 *
		 * ⚠️ **R-PET-10（发起人 2026-09-26 第四轮反馈：「点击落下去之后没有真的落下去啊」）**：
		 * 上面那条路径有一半不在这个函数里 —— `airborne = true` 只是"把下落立起来"，
		 * 真正让它掉下去的是 `step()` 里的重力积分，而 `step()` 只在 rAF 循环里跑。
		 * 于是有两个入口会让「落下去」变成"只换档、不落地"：
		 *   ① `prefers-reduced-motion: reduce`：`start()` **根本不开 rAF 循环**（设计如此），
		 *      重力积分永远不被推进 → 宠物带着 `mode=ground + airborne=true` 冻在半空；
		 *   ② 聊天框开着：`step()` 原来在重力分支**之前** `if (pet.dragging || chatOpen) return;`。
		 * 两条都在真机上复现过（见 §14.3 T45/T46 与 `reports/` 里的真机采样）。
		 * ① 的选择是**直接落到地面线**（不是"修好动画"）：减少动态这一档本来就不做位移动画，
		 * 而"落下去"是用户要的**落点**、不是装饰；语义与 `__imissSetMode("ground")` 的
		 * "直接定位"一致。② 的修法是把 `chatOpen` 那道闸门挪到重力分支**之后**（见 `step()`）。
		 */
		function startFall(): void {
			pet.walking = false;
			pet.busyUntil = 0;
			pet.airborne = pet.y < floorY - 2; // 离地不足 2px 就当已经在地面上
			pet.vy = pet.airborne ? 60 : 0; // 60 = 拖动松手时的初速（P3 原值）
			if (!pet.airborne || reduce) {
				// 已经在地面线附近（贴地档再点一次 / 固定档被拖到最下面，`clampY` 允许 y 到 vh−h，
				// 比 `floorY` 还低几像素）→ **对齐到地面线**，别停在离地 −7px 的位置；
				// 或者这一档没有 rAF 循环（reduce）→ 直接落地。两条都必须是"立刻、可见"的，
				// 不能让宠物带着 airborne 卡住（R-PET-10 的硬要求：落下去必须真的落地并保持）。
				pet.y = floorY;
				pet.vy = 0;
				pet.airborne = false;
				setState("idle");
				pet.nextAt = performance.now() + 900;
				applyTransform(); // setState 在"状态没变"时会提前返回、不重画，这里自己落一次位
				return;
			}
			setState(PET_FLIGHT_POSE.state, 0, PET_FLIGHT_POSE.loop);
			// 姿态是循环的"悬空帧"，不能被一次性动画的收尾逻辑（step 里的 busyUntil 分支）接管
			pet.busyUntil = 0;
		}

		/**
		 * 切模式：启动时按配置调一次；验收脚本的 `__imissSetMode()` 也走这里（不是旁路）。
		 * 切完位置一律 clamp 回视口 —— 贴地 → 落回地面；悬浮 → 抬到悬浮基准线；
		 * 固定 → 就地停在当前高度（不悬浮、不掉落）。
		 *
		 * `smooth`（R-PET-08，菜单「落下去」/「飘起来」）：**不要瞬移**，走既有的位移路径 ——
		 *   · `ground` → `startFall()`（拖动松手那条重力落地，真的"掉下去"）；
		 *   · `float`  → `startFlight()` 的缓动插值竖直飘上悬浮基准线（不是"啪"地跳上去）。
		 * 默认 `false`：启动与调试钩子 `__imissSetMode()` 走的仍是"直接定位"原语义
		 * （验收脚本的 R-PET-06 逐档取样就靠它）。
		 */
		function setMode(next: PetMovementMode, smooth = false): void {
			pet.mode = next;
			el?.setAttribute("data-pet-mode", next);
			cancelFlight(false);
			pet.walking = false;
			pet.busyUntil = 0;
			pet.airborne = false;
			pet.vy = 0;
			pet.asleep = false;
			pet.x = clampX(pet.x);
			const now = performance.now();
			/** 平滑上升的目标高度（只有 `float` + `smooth` 会填） */
			let liftTo: number | null = null;
			if (next === "ground") {
				if (smooth) {
					// 位置**不动**：交给 startFall() 从当前高度掉下去（下面统一调）
					pet.nextAt = now + 1800;
				} else {
					pet.y = floorY;
					pet.nextAt = now + 1800;
				}
			} else if (next === "float") {
				// 从地面切过来时 y 贴着地（离地不足）→ 抬到悬浮基准线；本来就在半空 → 就地悬停
				const base = pet.y <= maxAirY() - 8 ? clampAirY(pet.y) : floatBaseY();
				pet.hoverBase = base;
				pet.hoverPhase = 0;
				pet.nextAt = now + nextFlyDelay();
				if (smooth && base < pet.y - 8) {
					liftTo = base; // 贴地档回悬浮：交给飞行插值往上飘（下面统一调）
				} else {
					pet.y = base;
				}
			} else {
				pet.y = clampY(pet.y);
				pet.nextAt = Number.POSITIVE_INFINITY; // 固定：不再安排任何自动动作
			}
			setState("idle");
			applyTransform();
			syncMenuMode(); // 档位换了 → 菜单里「落下去」/「飘起来」二选一也要跟着换
			placeMenu(); // 切档会整块换高度（贴地/悬浮/固定），菜单要跟着重排
			if (!smooth) return;
			if (next === "ground") {
				startFall();
			} else if (next === "float" && liftTo !== null && !startFlight(now, true, { x: pet.x, y: liftTo })) {
				// 起不来（reduced-motion 下不飞 / 已经在飞）→ 退回"直接定位到悬浮基准线"，
				// 不能让宠物带着 float 的档位卡在地面上
				pet.y = liftTo;
				pet.hoverBase = liftTo;
				pet.hoverPhase = 0;
				applyTransform();
				placeMenu();
			}
		}

		/* ── 每帧 ───────────────────────────────────────── */
		function step(dt: number, now: number): void {
			if (pet.busyUntil && now >= pet.busyUntil) {
				pet.busyUntil = 0;
				pet.walking = false;
				setState("idle");
				// ⚠️ `nextAt` 的含义按模式不同：贴地档是"下一次自由活动"，悬浮档是"下一次飞行"，
				// 固定档是 Infinity（永不）。所以**只有贴地档**能在一次性动画收尾时重排它：
				// 改过一版三种模式都重排，结果出场招呼 2.8s 一结束就把飞行提前到 1.2~4.2s 后，
				// 页面加载 7 秒就飞了 —— 配置写的是 20~60 秒（独立探针 reports/_rpet06-autoflight-probe.mjs 实测到的偏差）。
				if (pet.mode === "ground") pet.nextAt = now + 1200 + Math.random() * 3000;
			}

			// ⚠️ R-PET-10：「聊天框开着」这道闸门**必须在重力分支之后**（原来它在前面，
			// `if (pet.dragging || chatOpen) return;`）。真机复现：聊天框开着点「落下去」→
			// `startFall()` 把 `airborne` 立起来、`vy` 给了初速，可 `step()` 每次都在这里返回，
			// 下面那段重力积分一次都没跑 —— 宠物带着 `mode=ground + airborne=true` 卡在半空
			// （实测 y=396 连续 1.5 秒不动、离地 370px），菜单却已经换成「飘起来」。
			// 拖动仍然留在前面：拖动期间 y 由指针直接写（`onPointerMove`），重力不能跟它抢。
			if (pet.dragging) return;

			// ① 自由落体：**只有贴地模式有重力**（悬浮/固定松手不落地，R-PET-06）
			if (pet.mode === "ground" && pet.airborne) {
				pet.vy += gravity * dt;
				pet.y += pet.vy * dt;
				if (pet.y >= floorY && pet.vy >= 0) {
					const impact = pet.vy;
					pet.y = floorY;
					if (impact > 1100) {
						pet.vy = -impact * 0.26;
					} else {
						pet.vy = 0;
						pet.airborne = false;
						setState("jumping", 420);
					}
				}
				return;
			}

			// 聊天框开着：重力（上面 ①）照跑，但**不再**走"走路位移 / 悬浮浮动 / decide()"。
			// 放在这里而不是函数开头，就是为了让"聊天时点落下去 / 聊天时松手落地"仍然落得下去。
			if (chatOpen) return;

			// ② 位移：贴地是"走"，悬浮是"飘"（悬浮时同时继续上下浮动）
			// R-PET-09「跳的时候就不要动了」：一次性跳跃（含落地弹跳）动画播放期间 `frozen` 为真，
			// 走路位移与悬浮浮动**都停住** —— 位置定住，只有图集在动；动画播完（busyUntil 到期）
			// 自动恢复原来的档位行为（`frozen` 只看 `state === "jumping"` + busyUntil 未到，
			// 所以"落下去"的自由落体不受影响：那条路径 busyUntil 是 0，且有专门的重力分支）。
			const frozen = pet.state === "jumping" && pet.busyUntil > now;
			if (pet.mode !== "fixed" && pet.walking && !frozen) {
				const dir = pet.targetX > pet.x ? 1 : -1;
				const speed = walkSpeed * (pet.mode === "float" ? glideSpeedFactor : 1);
				const nx = pet.x + dir * speed * dt;
				if ((dir > 0 && nx >= pet.targetX) || (dir < 0 && nx <= pet.targetX)) {
					pet.x = pet.targetX;
					stopWalking(now);
				} else {
					pet.x = nx;
				}
				if (pet.mode === "float") hoverStep(dt);
				return;
			}

			// ③ 悬浮飞行 + 上下浮动（跳跃动画期间同样停住）
			if (pet.mode === "float" && !frozen) {
				if (pet.flight) {
					advanceFlight(now);
					return;
				}
				hoverStep(dt);
			}

			if (!frozen && !pet.asleep && !pet.busyUntil && now >= pet.nextAt) decide(now);
		}

		function decide(now: number): void {
			// 「关闭」档（R-PET-13）：迷你期间不自动做任何事，并把计时器顶到无穷大 ——
			// 这条是**唯一**的调度咽喉，任何别的路径（换主题的庆祝、恢复时的 nextAt 重排）
			// 把 nextAt 改回有限值，也会在这里重新被按住。
			if (pet.mini) {
				pet.nextAt = Number.POSITIVE_INFINITY;
				return;
			}
			// 固定模式：不自动做任何事（发起人要的就是"固定、不给飞"）
			if (pet.mode === "fixed") {
				pet.nextAt = Number.POSITIVE_INFINITY;
				return;
			}
			// 悬浮模式：不走路，到点就飘到下一个随机点（阅读页的间隔在 nextFlyDelay() 里已拉长）
			if (pet.mode === "float") {
				startFlight(now); // 起不来（睡着/目标太近）时它自己安排了重试
				return;
			}
			// 贴地模式：原有行为，一行没改
			// （R-PET-08 备注：菜单里的「睡一会儿」入口已按发起人要求移除，但 `waiting`
			//   **不是死状态** —— hookInputs 里那个 3000ms 的巡检到 `idleSecondsToSleep`
			//   仍会 `pet.asleep = true; setState("waiting")`，这里的随机行为也照旧被 `pet.asleep` 挡住。）
			// 阅读页安静一点：站着就好，别在正文下面来回走
			if (root.dataset.petRoute === "post") {
				pet.nextAt = now + 9000;
				return;
			}
			const r = Math.random();
			if (r < 0.5) {
				walkTo(edge + Math.random() * Math.max(1, vw - w - edge * 2), now);
			} else if (r < 0.62) {
				setState("waving", 1900);
				pet.nextAt = now + 2200;
			} else if (r < 0.72) {
				setState("jumping", 900);
				pet.nextAt = now + 1300;
			} else if (r < 0.8) {
				setState("failed", 1500);
				pet.nextAt = now + 1800;
			} else {
				pet.nextAt = now + 4000 + Math.random() * 9000;
			}
		}

		function walkTo(x: number, now: number): void {
			// 固定模式：不位移（键盘 ←→ 也不动）。
			// R-PET-08：菜单里的「跟过来」入口已按发起人要求移除（原话："这两个没有鸟用啊"），
			// 但**函数本体仍在使用** —— 键盘 ←/→（keydown 分支）与贴地档 decide() 的随机走都调它。
			if (pet.mode === "fixed") return;
			cancelFlight(); // 手动指挥优先：立刻中断正在进行的飞行
			pet.targetX = clampX(x);
			if (Math.abs(pet.targetX - pet.x) < 6) {
				pet.nextAt = now + 2000;
				return;
			}
			const right = pet.targetX > pet.x;
			wake();
			pet.walking = true;
			pet.busyUntil = 0;
			setFace(right ? 1 : -1);
			setState(right ? "running-right" : "running-left");
		}

		function stopWalking(now: number): void {
			pet.walking = false;
			setState("idle");
			if (pet.mode === "float") {
				// 飘到位之后就在这儿继续悬着，接着排下一次飞行
				pet.hoverBase = clampAirY(pet.y);
				pet.hoverPhase = 0;
				pet.nextAt = now + nextFlyDelay();
			} else {
				pet.nextAt = now + 2500 + Math.random() * 6000;
			}
		}

		function draw(dt: number): void {
			const s = PET_STATES[pet.state];
			const dur = 1 / s.fps;
			pet.acc += dt;
			while (pet.acc >= dur) {
				pet.acc -= dur;
				pet.frame++;
				// 一次性动画停在末帧；飞行姿态（poseLoop）例外：飞行有 4~6 秒，要循环才不死板
				if (pet.frame >= s.frames) pet.frame = s.once && !pet.poseLoop ? s.frames - 1 : 0;
			}

			applyTransform();

			const col = pet.frame % COLS;
			const px = (col / (COLS - 1)) * 100;
			const py = (s.row / (ROWS - 1)) * 100;
			if (px !== pet.px || py !== pet.py) {
				pet.px = px;
				pet.py = py;
				if (sprite) sprite.style.backgroundPosition = `${px}% ${py}%`;
			}

			// 脚下的影子：离地越高越小越淡。悬浮/固定模式常驻半空，最淡档再压一档，
			// 免得半空中悬着一团明显的黑影（R-PET-06）
			const air = Math.max(0, floorY - pet.y);
			const k = Math.max(pet.mode === "ground" ? 0.35 : 0.22, 1 - air / 320);
			el?.style.setProperty("--pet-shadow", k.toFixed(3));
		}

		function tick(now: number): void {
			raf = requestAnimationFrame(tick);
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			step(dt, now);
			draw(dt);
		}

		function start(): void {
			if (raf || reduce || document.hidden) return;
			last = performance.now();
			raf = requestAnimationFrame(tick);
		}

		function stop(): void {
			if (raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
		}

		/* ── 说话 / 气泡 ─────────────────────────────────── */
		function randomLine(): string {
			const lines = petConfig.lines;
			let i = lastLine;
			while (lines.length > 1 && i === lastLine) i = Math.floor(Math.random() * lines.length);
			lastLine = i;
			return lines[i];
		}

		function say(text?: string): void {
			// 「关闭」档闭嘴（R-PET-13）：迷你期间一句台词都不冒 ——
			// 缩小 + 还在头顶弹气泡，等于"没关掉，只是变小了但更吵"。
			// ⚠️ 恢复的那句在 `setMini(false)` **之后**才调，所以它不会被这条挡掉。
			if (pet.mini) return;
			// 聊天框开着时也**一个字都不许说**（R-PET-14）：这条台词路径是直接写
			// `bubble.textContent` 的，而聊天面板就长在 `#pet-bubble` 里 ——
			// 点一下宠物本體（走 `jump(); say();`）会把整个面板的 DOM **冲掉**：
			// `chatList` / `chatInput` 当场变成游离节点，之后输入框还在（是引用），
			// 但历史区再也长不出来、清空按钮也不工作。发起人的口径是「点角色**不**关框」，
			// 所以这条路径要的是"只跳、不说话"。聊天里的每一句都走 `addLine()`，不经这里。
			if (chatOpen) return;
			const msg = text || randomLine();
			bubble.textContent = msg;
			const cx = pet.x + w / 2;
			bubble.classList.toggle("is-left", cx < 150);
			bubble.classList.toggle("is-right", cx > vw - 150);
			bubble.classList.remove("is-pop");
			void bubble.offsetWidth;
			bubble.classList.add("is-pop");
			clearTimeout(sayTimer);
			sayTimer = window.setTimeout(() => bubble.classList.remove("is-pop"), 4200);
		}

		/* ── 对话：历史区 / 思考中 / 上屏（R-PET-11 重做）────────────────────
		   为什么不让适配层直接写 DOM：适配层要能被单独测（`verify:ui` 里那几条
		   零请求 / 泄漏 / 降级断言都不该依赖气泡），DOM 与九状态联动留在这里。

		   上屏口径（发起人图证的两条毛病都出在这里）：
		     · 思考中**不铺正文**：流式增量只进 `chatStreamBuf`，界面上只有一个
		       `.pet-chat-thinking`（动画省略号 + 轮换短句 + 已收到的字数）；
		     · 完成后**整段清洗**再上屏（`cleanMarkdown()`），`**` / `#` / `|` / `>`
		       这些裸符号一律不会漏给访客 —— 流式途中上屏就没法保证这一点
		       （半个 `**` 会先露出来）。 */

		/**
		 * 历史区里**最新一句「爱弥斯说的话」**打上 `.pet-chat-reply`。
		 * ⚠️ 这个类名是**对外的接口**（`verify:ui` 的 R-AGT 段一直用它当"答复"），
		 * 语义是"此刻该被当作答复的那一条"——所以它必须**跟着最新一条走**：
		 * 不当成"每条答复都挂"（那样 `querySelector` 会永远返回第一条，
		 * 变成"第 2 问显示第 1 问的答复"这种 bug）。
		 * 只挂在 `.pet-chat-text` 上（不含"爱弥斯/时间"这些装饰），
		 * 这样 `textContent` 就是**纯答复正文**，长度断言（500 字那条）才对得上。
		 */
		function markLatestReply(): void {
			for (const t of bubble.querySelectorAll(".pet-chat-text")) t.classList.remove("pet-chat-reply");
			const rows = bubble.querySelectorAll<HTMLElement>('.pet-chat-line[data-role="ai"], .pet-chat-line[data-role="notice"]');
			const last = rows[rows.length - 1];
			last?.querySelector(".pet-chat-text")?.classList.add("pet-chat-reply");
		}

		/** 历史区空的时候给一句引导（有历史就不显示，免得占地方） */
		function ensureEmptyHint(): void {
			if (!chatList) return;
			const has = chatList.querySelector(".pet-chat-empty");
			if (!chatLog.length && !has) {
				const hint = document.createElement("div");
				hint.className = "pet-chat-empty";
				hint.textContent = "聊点什么？我在这儿。";
				chatList.insertBefore(hint, chatThink);
			} else if (chatLog.length && has) {
				has.remove();
			}
		}

		/** 复制一段文本（R-PET-11 的附加优化）。优先异步剪贴板，失败退回选区复制 */
		function fallbackCopy(text: string): boolean {
			try {
				const ta = document.createElement("textarea");
				ta.value = text;
				ta.setAttribute("aria-hidden", "true");
				ta.style.position = "fixed";
				ta.style.opacity = "0";
				document.body.appendChild(ta);
				ta.select();
				// `execCommand("copy")` 是**唯一的同步兜底**（非安全上下文里没有
				// `navigator.clipboard`）。它被标记为 deprecated，所以按"字符串索引的未知方法"
				// 取用，免得 `astro check` 每次都报一条 ts(6387) 提示（提示不致命，但会淹没真问题）。
				const legacy = document as unknown as Record<string, ((cmd: string) => boolean) | undefined>;
				const ok = legacy.execCommand?.("copy") ?? false;
				ta.remove();
				return ok;
			} catch {
				return false;
			}
		}

		function copyText(text: string, btn: HTMLButtonElement): void {
			const done = (ok: boolean) => {
				btn.textContent = ok ? "已复制" : "复制不了";
				window.setTimeout(() => {
					btn.textContent = "复制";
				}, 1400);
			};
			try {
				if (navigator.clipboard?.writeText) {
					void navigator.clipboard
						.writeText(text)
						.then(() => done(true))
						.catch(() => done(fallbackCopy(text)));
					return;
				}
			} catch {
				/* 非安全上下文 / 无权限：直接走兜底 */
			}
			done(fallbackCopy(text));
		}

		/** 建一条历史（用户 / 爱弥斯 / 提示）—— 只碰结构，文本一律 `textContent` 赋值（不拼 HTML） */
		function buildLine(line: ChatLine): HTMLElement {
			const row = document.createElement("div");
			row.className = "pet-chat-line";
			row.dataset.role = line.role;
			const meta = document.createElement("div");
			meta.className = "pet-chat-meta";
			const who = document.createElement("span");
			who.className = "pet-chat-who";
			who.textContent = line.role === "user" ? "你" : "爱弥斯";
			const at = document.createElement("time");
			at.className = "pet-chat-at";
			at.textContent = formatClock(line.at);
			meta.append(who, at);
			const textEl = document.createElement("div");
			textEl.className = "pet-chat-text";
			textEl.textContent = line.text;
			row.append(meta, textEl);
			// 长答复：默认折叠 + 「展开全文」（阈值见 petConfig.chat.collapseChars 的注释：
			// 定得比"真后端实测的 439~496 字"高，常规答复不折，只兜极端长文）
			const tools = document.createElement("div");
			tools.className = "pet-chat-tools";
			if (line.role !== "user" && line.text.length > 8) {
				const copy = document.createElement("button");
				copy.type = "button";
				copy.className = "pet-chat-copy";
				copy.textContent = "复制";
				copy.title = "把这条答复复制走";
				copy.addEventListener("click", () => copyText(line.text, copy));
				tools.appendChild(copy);
			}
			if (line.role === "ai" && shouldCollapse(line.text, CHAT.collapseChars)) {
				textEl.classList.add("is-long");
				const expand = document.createElement("button");
				expand.type = "button";
				expand.className = "pet-chat-expand";
				expand.textContent = "展开全文";
				expand.addEventListener("click", () => {
					const open = textEl.classList.toggle("is-open");
					expand.textContent = open ? "收起" : "展开全文";
				});
				tools.appendChild(expand);
			}
			if (tools.childElementCount) row.appendChild(tools);
			return row;
		}

		/** 是不是"贴着底部看"（决定新消息要不要自动滚；离底 > 28px 就认为用户在往回翻） */
		function chatNearBottom(): boolean {
			return bubble.scrollHeight - bubble.scrollTop - bubble.clientHeight <= 28;
		}

		/** 「回到最新」按钮的显隐（用户往回翻时才出现） */
		function showJump(on: boolean): void {
			if (chatJump) chatJump.hidden = !on;
		}

		function scrollChatToBottom(force = false): void {
			if (!force && !chatNearBottom()) {
				showJump(true);
				return;
			}
			bubble.scrollTop = bubble.scrollHeight;
			showJump(false);
		}

		/**
		 * 追加一条并（默认）滚到最新。
		 * ⚠️ **"要不要跟着滚"在插入之前算**（`chatNearBottom()` 读的是插入前的几何）：
		 *    先插入再判断的话，新内容自己就把 `scrollHeight` 撑大了 —— 差值立刻超过阈值，
		 *    于是每一句都被判成"用户在往回翻"，自动滚动等于失效（自检探针实测：
		 *    4 轮之后 `scrollTop 353 / scrollHeight 901 / clientHeight 458`，停在离底 90px 处）。
		 * ⚠️ 插入点是**思考指示之前**：它必须永远排在历史最后一行（视觉上"它在想下一句"），
		 * 不能因为"先 addLine 后 setThinking"的次序被甩到中间去。
		 */
		function addLine(role: ChatLine["role"], raw: string, doScroll = true): void {
			if (!chatList) return;
			const text = role === "user" ? cleanUserText(raw, petConfig.agent.maxLength) : cleanMarkdown(raw);
			if (!text) return;
			const nearBottom = chatNearBottom(); // ⚠️ 必须在插入之前算，理由见函数头
			const line: ChatLine = { role, text, at: Date.now() };
			chatLog.push(line);
			// 历史上限：丢最旧的（DOM 与数组一起丢，不留"看不见但还在"的幽灵行）
			while (chatLog.length > CHAT.historyLimit) {
				chatLog.shift();
				chatList.querySelector(".pet-chat-line")?.remove();
			}
			chatList.insertBefore(buildLine(line), chatThink);
			ensureEmptyHint();
			markLatestReply();
			if (role !== "user") lastReply = text;
			if (doScroll) {
				if (nearBottom) {
					bubble.scrollTop = bubble.scrollHeight;
					showJump(false);
				} else {
					showJump(true);
				}
			}
		}

		/** 清空历史区里所有行（只动 DOM；`chatLog` 由调用方维护） */
		function clearLineNodes(): void {
			if (!chatList) return;
			for (const el of chatList.querySelectorAll(".pet-chat-line, .pet-chat-empty")) el.remove();
		}

		/** 轮换「思考中」的短句（至少 3 条，见 petConfig.chat.thinkingLines） */
		function rotateThinking(): void {
			const lines = CHAT.thinkingLines;
			if (!lines.length || !chatThinkText) return;
			let i = thinkIdx;
			if (lines.length > 1) {
				while (i === thinkIdx) i = Math.floor(Math.random() * lines.length);
			} else {
				i = 0;
			}
			thinkIdx = i;
			chatThinkText.textContent = lines[i];
		}

		/** 「已经写了 N 字…」——不含正文，只让长回合有进展感 */
		function setStreamProgress(chars: number): void {
			if (chatRecv) {
				chatRecv.textContent = chars > 0 ? `已经写了 ${chars} 字…` : "";
				chatRecv.hidden = chars <= 0;
			}
			bubble.dataset.petChatRecv = String(chars);
		}

		/**
		 * 思考指示的开关（R-PET-11 的**核心可见状态**）。
		 * 开启：显示省略号 + 短句 + 轮换定时器；给发送按钮上 `data-pet-busy` 与
		 * `aria-disabled`，并把面板标成 `data-pet-chat-state="thinking"`。
		 * ⚠️ 发送按钮**不进原生 `disabled`**：原生 disabled 会让表单的隐式提交（回车）
		 *    整条失效，而那正是 P5 复核 D-9 点名要保住的路径（"在飞时又按发送"要给出可见
		 *    反馈、且不丢用户输入）。所以"禁用"落在**行为守卫 + 视觉 + aria** 上：
		 *    提交守卫仍然拒绝重复提交，样式置灰，读屏读到的是 disabled。
		 */
		function setThinking(on: boolean): void {
			clearInterval(thinkRotateTimer);
			thinkRotateTimer = 0;
			if (chatThink) chatThink.hidden = !on;
			if (on) {
				chatStreamBuf = "";
				setStreamProgress(0);
				rotateThinking();
				thinkRotateTimer = window.setInterval(rotateThinking, Math.max(1200, CHAT.thinkingRotateMs));
				scrollChatToBottom(true);
			} else if (chatRecv) {
				chatRecv.hidden = true;
			}
			bubble.dataset.petChatState = on ? "thinking" : "idle";
			if (chatSend) {
				if (on) {
					chatSend.dataset.petBusy = "1";
					chatSend.setAttribute("aria-disabled", "true");
				} else {
					delete chatSend.dataset.petBusy;
					chatSend.removeAttribute("aria-disabled");
				}
			}
		}

		/** 收尾（无论网络那侧发生了什么）：解锁输入、停"思考中"指示、按会话比一次再复位 */
		function endTrip(session: number, state: PetStateName, hold = 0): void {
			if (chatSession !== session) return;
			chatBusy = false;
			setThinking(false);
			reEnableInput();
			// 这一轮飞着的时候用户按过发送（D-9）：现在给一句**看得见**的交代 ——
			// 他刚打的那句话还在输入框里，提醒他再发一次，而不是让他对着没反应的气泡猜。
			if (chatPendingRetry) {
				chatPendingRetry = false;
				const pendingText = (chatInput?.value ?? "").trim();
				if (pendingText) addLine("notice", BUSY_HINT);
			}
			setState(state, hold);
			if (hold > 0) {
				// 一次性动画播完回到"聊天中该有的样子"（`running`），而不是回待机：
				// 聊天框还开着的时候宠物打瞌睡很怪，而且下一次提问的状态切换会看不出来。
				clearTimeout(stateTimer);
				stateTimer = window.setTimeout(() => {
					if (chatOpen && chatSession === session && !pet.dragging) setState("running");
				}, hold + 80);
			}
		}

		/**
		 * 把输入框放回可用（并清掉"发送"上的锁标记）。
		 * ⚠️ 降级之后**必须**还能继续问：R-AGT-03 与 §8.9.6 第 4 条写的是"仍然可用、
		 * 能连续降级、能重试"，而输入框一旦被锁死，用户看到的就是"坏了"。
		 */
		function reEnableInput(): void {
			if (chatInput) {
				chatInput.disabled = false;
				chatInput.removeAttribute("data-pet-busy");
			}
			if (chatSend) {
				delete chatSend.dataset.petBusy;
				chatSend.removeAttribute("aria-disabled");
			}
			if (chatOpen && chatInput && document.activeElement !== chatInput) chatInput.focus();
		}

		/** 清掉这一轮的全部残留（关框 / 切页都走它），顺带把状态从"思考中"摘出来 */
		function clearChatRuntime(): void {
			chatSession++;
			chatBusy = false;
			chatPendingRetry = false;
			chatAsk = null;
			chatResume = null;
			lastReply = "";
			chatStreamBuf = "";
			histIdx = -1;
			setThinking(false);
			clearTimeout(stateTimer);
			chatAbort?.abort();
			chatAbort = null;
		}

		/**
		 * 把一次问答交给适配层，并把结果落到历史区与九状态上（R-AGT-03 / R-AGT-04）。
		 * 状态口径（**复用现有九状态，不新增**）：
		 *   · 发出请求 → `running`（"执行任务"）。为什么不用 `review`：`review` 是 `once`
		 *     一次性动画 + 一次星屑庆祝，语义是"完成了"；用它在"还在等"的时候眨眼会误导。
		 *   · 失败 / 降级 → `failed`（"困惑"，1500ms 后回 `running`，聊天框还开着不算待机）。
		 *   · 拿到答复 → `review`（"完成反馈"）。
		 * ⚠️ R-PET-11：流式增量**不上屏**（只记字数），答复在 `turn` 落地时整段清洗后一次上屏。
		 */
		/**
		 * 这一轮的答复**是哪来的**（v1.37，发起人 2026-09-27 图证）。
		 * 只写一个只读标记（`data-pet-chat-source`），不改文案、不改状态机：
		 *   · `"live"`     —— 真从后端拿到的答复（含 `interrupt` 那一轮）；
		 *   · `"fallback"` —— 后端不可达 / 契约不符 / 命中禁词闸门 → 气泡里是降级台词；
		 *   · `"mock"`     —— 配置关掉（`enable:false`，一个请求都没发）。
		 * 为什么要它：降级台词与真答复**长得一模一样**，访客分不出"她在回答"还是"她没接上"；
		 * 有了这个标记，`verify:ui` 才能用"不靠文本"的判据把两种情况分开。
		 */
		function setReplySource(kind: "live" | "fallback" | "mock"): void {
			bubble.dataset.petChatSource = kind;
		}

		function runAsk(message: string, pending: string | null): void {
			const session = chatSession;
			chatBusy = true;
			chatAsk = null;
			chatResume = null;
			chatPendingRetry = false;
			setState("running");
			setThinking(true);

			chatAbort?.abort();
			const ac = new AbortController();
			chatAbort = ac;

			void askAemeath(message, {
				signal: ac.signal,
				// `pending` = 后端上一轮反问过（用户这句很可能是对它的回答）；
				// 适配层再按约定词判一次，**不匹配就当新消息发**（契约：不匹配也不许报错）
				lastReply: pending ? lastReply : undefined,
				// **看得见的历史**（v1.99）：只在"后端重启 → 旧线程失效 → 新建线程"那条自愈路径上用，
				// 适配层会把最近 N 轮重放给新线程（否则新线程什么都不知道，见 `agentConfig.contextReplay`）。
				// ⚠️ `chatLog` 是**唯一事实来源**（DOM 每次开框按它重建），所以"重放的上下文"与
				//    "访客在历史区里看到的东西"永远是同一份；`notice` 那类系统提示由适配层过滤掉。
				history: chatLog
					.filter((l) => l.role === "user" || l.role === "ai")
					.map((l) => ({
						role: l.role === "user" ? ("human" as const) : ("ai" as const),
						text: l.text,
					})),
				events: {
					onReply: (text) => {
						// 中途的流式增量：会话变了就丢掉（不能往已经关掉的气泡里写）
						if (chatSession !== session) return;
						chatStreamBuf = text;
						setStreamProgress(text.length);
					},
				},
			}).then((turn: AgentTurn) => {
				if (chatSession !== session) return; // 关框 / 切页之后的迟到结果，丢掉
				chatStreamBuf = "";
				if (turn.status === "interrupt") {
					chatAsk = turn.interrupt?.ask ?? null;
					chatResume = turn.interrupt?.reply ?? null;
					// ⚠️ 两种 `interrupt` 形态都要照顾（实测见 agent-client.ts 的 T53 注释）：
					//   · `recommended_agent`：先反问、**没有**答复 → 气泡就是那句反问；
					//   · `blog_agent` 检索链路：**先给答复、再反问**（要不要收进本子）→
					//     答复必须留在气泡里，只显示反问会把刚查到的文章列表丢掉。
					// 适配层已经按这个顺序拼好 `text`（答复在前、反问在后），这里原样上屏。
					// ⚠️ **答复不许截断**（P5 复核 D-7）：`ASK_MAX_CHARS` 的初衷是"询问原文太长"，
					//    旧实现把它套在整段（答复+反问）上 → 450 字的文章列表被砍成 221 字。
					//    现在只对**纯反问**那一形态截断；长答复交给历史区的滚动与折叠（见 pet.css）。
					const onlyAsk = !turn.text.includes("\n\n");
					// v1.91：「回我「不提供」也行，我替你挑。」这句提示**只对"约定词那一类"反问成立**
					//（要不要收进本子 / 篇幅多少字）。「你说的是哪一篇？回我序号就行」那一类要的是
					// 序号或篇名 —— 配这句提示会把人往错的方向带（发起人就是这么踩到的），
					// 而反问原文里已经写清了该怎么答，原样上屏即可。
					const hint = turn.interrupt?.kind === "choice" ? "" : `\n\n${INTERRUPT_HINT}`;
					setReplySource("live");
					addLine("ai", onlyAsk ? `${trimAsk(turn.text, true)}${hint}` : turn.text);
					endTrip(session, "running");
					return;
				}
				if (turn.status === "disabled") {
					// 配置关闭**不是故障**：别播"困惑"动画（复核 D-11），也别按降级计
					setReplySource("mock");
					addLine("ai", turn.text);
					endTrip(session, "running");
					return;
				}
				if (turn.status === "fallback") {
					setReplySource("fallback");
					addLine("ai", turn.text);
					// 降级不改输入框的可用性：还能接着问（契约 §8.9.6 第 4 条）
					endTrip(session, "failed", 1500);
					return;
				}
				setReplySource("live");
				addLine("ai", turn.text);
				endTrip(session, "review", REVIEW_HOLD);
			});
		}

		/** 询问原文可能很长（实测 100 字上下）：超长才截断，避免气泡顶出视口 */
		function trimAsk(text: string, cut = false): string {
			const t = text.trim();
			return cut && t.length > ASK_MAX_CHARS ? `${t.slice(0, ASK_MAX_CHARS)}…` : t;
		}

		/* ── 星屑（纯 CSS 动效，不引第三方）───────────────── */
		function spark(cx: number, cy: number, count: number): void {
			if (reduce) return;
			for (let i = 0; i < count; i++) {
				const s = document.createElement("span");
				const a = (Math.PI * 2 * i) / count + Math.random() * 0.6;
				const d = 22 + Math.random() * 38;
				s.className = "pet-spark";
				s.style.left = `${cx}px`;
				s.style.top = `${cy}px`;
				s.style.setProperty("--dx", `${(Math.cos(a) * d).toFixed(1)}px`);
				s.style.setProperty("--dy", `${(Math.sin(a) * d).toFixed(1)}px`);
				s.style.animationDelay = `${i * 9}ms`;
				document.body.appendChild(s);
				s.addEventListener("animationend", () => s.remove());
				window.setTimeout(() => {
					if (s.isConnected) s.remove();
				}, 1600);
			}
		}

		/* ── 交互 ───────────────────────────────────────── */
		function wake(): void {
			pet.lastActive = performance.now();
			if (pet.asleep) {
				pet.asleep = false;
				setState("idle");
				pet.nextAt = performance.now() + 800;
			}
		}

		/**
		 * 跳一下（**原地**动画）
		 * ============================================================================
		 * 两个入口：左键单击宠物（`onPointerUp`）与键盘 `Enter`（`role="button"` 的无障碍激活路径）。
		 * R-PET-09：菜单里的「跳一下」入口已按发起人要求删除（"左键点击就能跳所以按键没有必要"），
		 * 但**函数本体仍在使用**，所以留着。
		 * 发起人同一条反馈的前半句是"跳的时候就不要动了"：所以跳之前先把飞行与走路停掉
		 * （`cancelFlight()` + `pet.walking = false`），动画播放期间再由 `step()` 冻结位移
		 * （悬浮档不上下浮动、走路档不位移），跳完（`busyUntil` 到期）自动恢复原档位行为。
		 */
		function jump(): void {
			wake();
			cancelFlight(); // 中断正在进行的飞行（否则会"边飞边跳"）
			pet.walking = false; // 中断走路（否则会"边走边跳"）
			setState("jumping", 700);
			pet.nextAt = performance.now() + 900;
		}

		/**
		 * 进入「屏幕待机」（九状态里的 `waiting`）
		 * ============================================================================
		 * R-PET-08：菜单里的「睡一会儿」入口已按发起人要求移除（原话："这两个没有鸟用"），
		 * 但这个状态**不是死状态** —— hookInputs 里那个 3 秒巡检到 `idleSecondsToSleep`
		 * （45 秒无操作）仍会走到这里。判定之后的动作抽成一个函数，是为了让验收脚本的
		 * `__imissSleepNow()` 调**同一段逻辑**（与 R-PET-06 的 `__imissFlyNow()` / `__imissSetMode()`
		 * 同一个惯例：钩子不绕过行为，只跳过计时与前置换挡）。
		 */
		function doze(): void {
			pet.walking = false;
			pet.busyUntil = 0;
			pet.asleep = true;
			setState("waiting");
		}

		/**
		 * 「关闭」档（R-PET-13）
		 * ============================================================================
		 * 发起人原话：「**最后一个变成关闭，但关闭不是完全关闭，会变成很小一只，比待机还小，
		 * 双击后仍能变回爱弥斯**」。所以它是一个**缩放档**，不是 `enable: false`：
		 *   · 缩放本身走 CSS（`.pet[data-pet-mini="1"]` → `--pet-mini` = `petConfig.miniFactor`），
		 *     JS 只翻一个属性；尺寸不写死，靠 `measure()` 重新量真实 `offsetWidth`；
		 *   · 缩放会改 `w/h`，所以**脚底锚点要重新对齐**：先记住"底边"，量完再把底边放回去。
		 *     不这么做的话，`fixed` 档（y 是左上角）缩一半就等于"人原地向上蹿半个身位"；
		 *   · 迷你期间闭嘴、不自动活动、不进待机画面（三处分别是 `say()` / `decide()` / 45 秒巡检）；
		 *   · 双击她本體 = `setMini(false)`（`onPointerUp` 的双击分支），恢复后再挥一下爪。
		 * ⚠️ 这个函数**同时是"关"和"开"**：菜单末项与双击调的是同一个它，不要另写一份恢复逻辑，
		 *    否则"关"和"开"的锚点算法迟早会漂成两套。
		 */
		function setMini(on: boolean): void {
			if (pet.mini === on) return;
			const bottom = pet.y + h; // 缩放前的底边（脚底），量完要放回这个位置
			pet.mini = on;
			if (el) el.dataset.petMini = on ? "1" : "0";
			if (on) {
				closeChat(); // 关掉聊天框：迷你档不该还挂着一个 340px 的面板
				cancelFlight(false);
				pet.walking = false;
				pet.busyUntil = 0;
				clearTimeout(sayTimer);
				bubble.classList.remove("is-pop");
				bubble.textContent = ""; // 收起头上的那句话
				setState("idle");
				pet.nextAt = Number.POSITIVE_INFINITY;
			} else {
				setState("waving", 1900); // 回来了：挥一下爪
				pet.nextAt =
					pet.mode === "fixed"
						? Number.POSITIVE_INFINITY
						: performance.now() + (pet.mode === "float" ? nextFlyDelay() : 1800);
			}
			measure();
			if (!pet.airborne && pet.mode !== "ground") {
				// 贴地档由 measure() 直接落到新的 floorY（底边天然不变），这两档要手动对齐底边
				pet.y = clampY(bottom - h);
				if (pet.mode === "float") {
					pet.hoverBase = clampAirY(pet.y);
					pet.hoverPhase = 0;
				}
			}
			applyTransform();
			syncMenuMode(); // 末项文案跟着状态走（缩小 / 叫醒她）
			placeMenu();
			placeChat();
		}

		function onPointerDown(e: PointerEvent): void {
			if (e.button !== 0 && e.pointerType === "mouse") return;
			// 用户一动手（拖动或单击）就中断本次飞行（R-PET-06）
			cancelFlight();
			const r = hit?.getBoundingClientRect();
			if (!r) return;
			drag = {
				id: e.pointerId,
				dx: e.clientX - r.left,
				dy: e.clientY - r.top,
				moved: 0,
				x0: e.clientX,
				y0: e.clientY,
			};
			moveAcc = 0;
			wake();
			try {
				hit?.setPointerCapture(e.pointerId);
			} catch {
				/* 某些浏览器/指针类型不支持捕获，忽略 */
			}
		}

		function onPointerMove(e: PointerEvent): void {
			if (!drag || e.pointerId !== drag.id) return;
			drag.moved = Math.max(drag.moved, Math.abs(e.clientX - drag.x0) + Math.abs(e.clientY - drag.y0));
			if (drag.moved < 4 && !pet.dragging) return;

			if (!pet.dragging) {
				pet.dragging = true;
				pet.airborne = false;
				pet.vy = 0;
				pet.walking = false;
				pet.busyUntil = 0;
				hit?.classList.add("is-drag");
				setState("failed"); // 被拎起来：困惑脸
			}
			moveAcc += e.movementX || 0;
			if (Math.abs(moveAcc) > 14) {
				setFace(moveAcc > 0 ? 1 : -1);
				moveAcc = 0;
			}

			pet.x = Math.max(-w * 0.3, Math.min(vw - w * 0.7, e.clientX - drag.dx));
			pet.y = Math.max(0, Math.min(vh - h * 0.4, e.clientY - drag.dy));
			pet.userMoved = true;
			el?.style.setProperty("transform", `translate3d(${pet.x.toFixed(2)}px,${pet.y.toFixed(2)}px,0)`);
			// 菜单开着时跟着宠物走（R-PET-07：拖动后菜单不能留在原地）
			placeMenu();
		}

		function onPointerUp(e: PointerEvent): void {
			if (!drag || e.pointerId !== drag.id) return;
			const wasDrag = pet.dragging;
			const moved = drag.moved;
			drag = null;
			try {
				hit?.releasePointerCapture(e.pointerId);
			} catch {
				/* 忽略 */
			}

			if (wasDrag) {
				pet.dragging = false;
				hit?.classList.remove("is-drag");
				if (pet.mode === "ground") {
					// 贴地：松手受重力落地（P3 原行为）。
					// R-PET-08：起手那一小段抽成了 `startFall()`，菜单「落下去」走同一个入口 ——
					// 下落本身仍然是 step() 里那段重力积分，一处逻辑两处入口。
					startFall();
				} else if (pet.mode === "float") {
					// 悬浮：松手**就地悬停**，不掉落；很快再飘一次（刚被拖过，让它自己找找位置）
					pet.airborne = false;
					pet.vy = 0;
					pet.hoverBase = clampAirY(pet.y);
					pet.hoverPhase = 0;
					setState("idle");
					pet.nextAt = performance.now() + Math.min(8000, nextFlyDelay());
				} else {
					// 固定：松手停在原地，不下落也不漂移（R-PET-06）
					pet.airborne = false;
					pet.vy = 0;
					pet.y = clampY(pet.y);
					setState("idle");
					pet.busyUntil = 0;
					pet.nextAt = Number.POSITIVE_INFINITY;
				}
				savePos();
				placeChat(); // 拖完松手 → 聊天框重新贴回宠物旁边（拖动途中不跟，见 placeChat 的注释）
				return;
			}

			if (moved < 8) {
				const now = performance.now();
				if (now - pet.lastClick < 320) {
					pet.lastClick = 0;
					// R-PET-13：迷你时双击 = 把她叫回来（发起人：「双击后仍能变回爱弥斯」）。
					// 恢复与"两下"的庆祝共用同一段（星星 + review），只是台词不同 ——
					// 单击（下面那条 else）在迷你期间仍是"跳一下"，只是气泡被 say() 挡掉了。
					const back = pet.mini;
					if (back) setMini(false);
					setState("review", REVIEW_HOLD);
					pet.nextAt = now + 1200;
					const r = hit?.getBoundingClientRect();
					if (r) spark(r.left + r.width / 2, r.top + r.height * 0.42, 10);
					say(back ? "……我回来了。" : "两下！那我也高兴一下。");
				} else {
					pet.lastClick = now;
					jump();
					say();
				}
			}
		}

		function onDocMove(e: PointerEvent): void {
			pet.cursorX = e.clientX;
			wake();
			if (pet.dragging || pet.walking || pet.busyUntil || pet.asleep) return;
			const cx = pet.x + w / 2;
			if (Math.abs(e.clientX - cx) > w * 0.45) setFace(e.clientX > cx ? 1 : -1);
		}

		/* ── 浮层摆位（右键菜单 + 聊天框**共用这一份算法**，R-PET-08 / R-PET-11）──
		   ⚠️ 为什么要把 `placeMenu()` 抽成通用的 `placePanel()`：R-PET-11 要求聊天框
		      "像右键菜单那样出现在桌宠左边或右边"。如果给聊天框另写一套摆位，两份算法
		      迟早会给出互相矛盾的结果（同一个宠物位置，菜单说"贴左"、聊天框说"贴右"），
		      而且遮挡抽样这种有真机教训的逻辑（T41~T43）会被复制一遍、只修一份。
		      所以：**同一份选边 + 5 点抽样 + 让位 + 夹回视口**，调用方只给尺寸与两条可选约束。
		   `placeMenu()` 的对外行为（`data-pet-menu-side` / `-occluded` / `-nudged`）**一个字没改**。 */

		/** 菜单尺寸缓存（只为 clamp 用）：同一档位下菜单项固定，量一次就够。
		 *  视口尺寸变了会清零重量（`max-height: calc(100vh - 16px)` 会改变实际高度）；
		 *  R-PET-08 起**切档也会清零**（「落下去」/「飘起来」二选一，菜单高度会变，见 syncMenuMode）。 */
		let menuW = 0;
		let menuH = 0;

		/** 遮挡抽样的四角内缩量（px）：避开圆角/边框，别让"压在圆角外"被算成遮挡 */
		const PANEL_SAMPLE_INSET = 6;

		/** 浮层尺寸（px，摆位用） */
		interface PanelBox {
			w: number;
			h: number;
		}

		/** 摆位结果（视口坐标）；`nudged` = 为避让遮挡动过"自由轴"上的位置 */
		interface PanelPlacement {
			side: "left" | "right" | "above" | "below";
			left: number;
			top: number;
			miss: number;
			nudged: boolean;
		}

		interface PanelPlaceOpts {
			/** 与宠物之间的间隙 */
			gap: number;
			/** 与视口四边的安全边距 */
			margin: number;
			/**
			 * 两侧都放不下时是否允许改走"宠物上方/下方"。
			 * 菜单是 `false`（R-PET-08 实测过：视口窄到并排不了时"取空间更大的一侧"就好，
			 * 菜单只有 132px 宽、压住宠物 1~2px 可以接受）；聊天框是 `true`
			 * （340px 宽，硬塞会直接盖住宠物与正文，宁可上下摆）。
			 */
			verticalFallback: boolean;
			/**
			 * 视口坐标 → 节点自身坐标系（写 `style.left/top` 用）。
			 * 菜单是 `position:fixed` 的兄弟节点 → 原样（默认）；聊天框在 `.pet` 里
			 * （`.pet` 有 `transform`，fixed/absolute 都以它为包含块）→ 减 `pet.x/pet.y`。
			 * ⚠️ `elementFromPoint` 抽样用的仍然是**视口坐标**，转换只作用于写样式那一步。
			 */
			toLocal?: (left: number, top: number) => { left: number; top: number };
			/**
			 * 额外约束：在这个纵向带上，"右边最多能到哪"（px）。
			 * 聊天框用它避开右下角的浮动按钮列（返回顶部等）；菜单不传（行为保持原样）。
			 */
			rightEdgeFor?: (top: number, h: number) => number;
		}

		/**
		 * 从一个被命中的节点往上找到"真正盖住这一条"的祖先盒子。
		 * 为什么不能直接用命中节点：`elementFromPoint` 命中的往往是**遮挡带里的小元素**
		 * （实测是导航栏里的 `button.btn-plain`，它自己的 rect 只有按钮那么大，
		 * 而真正压住菜单的是外层 `#navbar-wrapper`，`z-index: 80`）。按小元素的底边让位
		 * 会落在同一条遮挡带里 —— 所以一路上溯到"仍然覆盖该点、且盒子更大"的最外层祖先。
		 */
		function occluderBox(node: Element, x: number, y: number): DOMRect {
			let box = node.getBoundingClientRect();
			let p = node.parentElement;
			for (let i = 0; i < 6 && p && p !== document.body && p !== document.documentElement; i++) {
				const r = p.getBoundingClientRect();
				if (
					r.width >= box.width &&
					r.height >= box.height &&
					x >= r.left &&
					x <= r.right &&
					y >= r.top &&
					y <= r.bottom
				) {
					box = r;
				}
				p = p.parentElement;
			}
			return box;
		}

		/**
		 * 把浮层摆到宠物的**左边或右边**（R-PET-08 的算法本体；R-PET-11 起菜单与聊天框共用）
		 * ============================================================================
		 * 发起人原话（R-PET-08）：「**右键出现的选择框最好是要出现在人物的左边或者右边**啊，
		 * 出现判断应该是**左边或右边区域够不够展开**，展开之后**会不会被遮挡**。」→ 四段式：
		 *   ① **选边**：两侧可用宽度 = 宠物矩形到视口边、扣掉 `margin`(8) 与 `gap`(10)；
		 *      `room >= box.w` 才算"这一侧放得下"。**优先右侧**，右侧放不下才翻左侧。
		 *      为什么默认右侧：本站是 LTR 排版，"从宠物向右读"与阅读方向一致；而且宠物的默认
		 *      出场位在**右下角**（`startSide: "right"` + 给浮动按钮预留 64px），右侧通常本来就
		 *      不够 —— 于是默认视觉上就是"贴在宠物左边"，也不会挡住右下角的浮动按钮列。
		 *      两侧都放不下：菜单**取空间更大的一侧**（几何上无解的兜底，132px 的菜单压住
		 *      宠物 1~2px 可以忍）；聊天框（`verticalFallback:true`）改走**上下兜底**（见 ⑤）。
		 *   ② **纵向**：顶部对齐宠物顶部（气泡在宠物上方，纵向对齐不会跟气泡打架），
		 *      再夹回 `[margin, vh - margin - box.h]` —— 宠物贴着屏幕上下边时也不溢出。
		 *   ③ **遮挡检测**：摆好之后用 `elementFromPoint` 抽 5 个点（中心 + 四角内缩），
		 *      命中的必须是**浮层自己**；**被挡住就换另一侧**（这是首选补救）。
		 *   ④ **兜底（两侧都被挡住）**：先试**自由轴让开遮挡物**（左右摆位时是纵向：挪到遮挡带
		 *      上/下沿之外，最多 3 轮，实测就是这条救回"宠物拖到最上面"的场景 —— 模板
		 *      `#navbar-wrapper` 是 `z-index: 80`，比浮层的 67 高）；让不开才取**遮挡点更少**
		 *      的一侧（明确兜底，不摆烂也不硬撑）。
		 *   ⑤ **上下兜底**（只有 `verticalFallback:true` 走）：优先宠物**下方**（阅读方向），
		 *      下方放不下翻上方，横向与宠物左对齐再夹回视口；同样过一遍抽样，被挡就在横向上
		 *      让开遮挡带（最多 3 轮）。
		 * ⚠️ 层级仍然只有 `petConfig.zIndex + 1` = 67（< 导航栏 80 / 浮动控件 1000 / 移动端面板 1100）：
		 * 这里是"换边 + 让位"，**不是**靠抬高 z-index 把别人压下去（R-PET-07 的 z-index 结论不变）。
		 */
		function placePanel(node: HTMLElement, box: PanelBox, opts: PanelPlaceOpts): PanelPlacement {
			const gap = opts.gap;
			const m = opts.margin;
			const pw = Math.max(1, box.w);
			const ph = Math.max(1, box.h);
			const toLocal = opts.toLocal ?? ((left: number, top: number) => ({ left, top }));
			const write = (left: number, top: number): void => {
				const p = toLocal(left, top);
				node.style.left = `${Math.round(p.left)}px`;
				node.style.top = `${Math.round(p.top)}px`;
			};
			const clampTop = (t: number): number => Math.max(m, Math.min(Math.max(m, vh - m - ph), t));
			const clampLeft = (l: number): number => Math.max(m, Math.min(Math.max(m, vw - m - pw), l));
			/** 浮层矩形内的抽样点：中心 + 四角内缩（内缩量取 `PANEL_SAMPLE_INSET` 与 1/4 中的小者） */
			const samplePoints = (l: number, t: number): Array<[number, number]> => {
				const ix = Math.min(PANEL_SAMPLE_INSET, Math.max(1, pw / 4));
				const iy = Math.min(PANEL_SAMPLE_INSET, Math.max(1, ph / 4));
				return [
					[l + pw / 2, t + ph / 2],
					[l + ix, t + iy],
					[l + pw - ix, t + iy],
					[l + ix, t + ph - iy],
					[l + pw - ix, t + ph - iy],
				];
			};
			/**
			 * 在这个位置上抽样：返回"没命中浮层自己"的点数与**遮挡方盒子**。
			 * ⚠️ 读的是**像素真话**：`document.elementFromPoint()` 返回的是真正画在最上面的元素，
			 * 遮挡方（壁纸 / 正文面板 / 侧栏 / 导航栏 / 任何 z-index 更高的浮层）会立刻暴露出来。
			 * 调用前必须已经把浮层摆到 (l, t) —— 它靠的是"当前这一刻的真实布局"。
			 */
			const sampleAt = (l: number, t: number): { miss: number; boxes: DOMRect[] } => {
				write(l, t);
				let miss = 0;
				const boxes: DOMRect[] = [];
				for (const [x, y] of samplePoints(l, t)) {
					const hitNode = document.elementFromPoint(x, y);
					if (hitNode && (hitNode === node || node.contains(hitNode))) continue;
					miss++;
					if (hitNode) {
						const o = occluderBox(hitNode, x, y);
						if (o.width > 0 && o.height > 0) boxes.push(o);
					}
				}
				return { miss, boxes };
			};

			/** 纵向：顶部对齐宠物顶部，再夹进视口 */
			const aligned = clampTop(pet.y);
			const rightEdge = opts.rightEdgeFor ? Math.min(vw - m, opts.rightEdgeFor(aligned, ph)) : vw - m;
			// ① 横向：两个候选（右优先），room = 这一侧"扣掉边距与间隙后"还剩多少
			const right = { side: "right" as const, raw: pet.x + w + gap, room: rightEdge - (pet.x + w + gap) };
			const left = { side: "left" as const, raw: pet.x - gap - pw, room: pet.x - gap - m };
			const fitting = [right, left].filter((c) => c.room >= pw);

			// ⑤ 上下兜底（只有聊天框这类大浮层会走到）：下方优先，放不下翻上方
			if (!fitting.length && opts.verticalFallback) {
				const belowTop = pet.y + h + gap;
				const aboveTop = pet.y - gap - ph;
				const belowFits = belowTop + ph <= vh - m;
				const aboveFits = aboveTop >= m;
				const pool = belowFits || !aboveFits ? [belowTop, aboveTop] : [aboveTop, belowTop];
				const geoV = pool.map((t) => ({ side: t === belowTop ? ("below" as const) : ("above" as const), left: clampLeft(pet.x), top: clampTop(t) }));
				let bestV: PanelPlacement | null = null;
				for (const g of geoV) {
					const t = g.top;
					let r = sampleAt(g.left, t);
					let miss = r.miss;
					let nudged = false;
					// 自由轴是横向：让开遮挡带（左右各试一次，取更干净的）
					for (let k = 0; k < 3 && r.miss > 0 && r.boxes.length; k++) {
						const right2 = clampLeft(Math.max(...r.boxes.map((b) => b.right)) + 4);
						const left2 = clampLeft(Math.min(...r.boxes.map((b) => b.left)) - 4 - pw);
						let step: { l: number; miss: number } | null = null;
						for (const l2 of [right2, left2]) {
							if (l2 === g.left) continue;
							const r2 = sampleAt(l2, t);
							if (r2.miss < r.miss && (step === null || r2.miss < step.miss)) step = { l: l2, miss: r2.miss };
						}
						if (!step) break;
						g.left = step.l;
						nudged = true;
						r = sampleAt(g.left, t);
						miss = r.miss;
					}
					if (!bestV || miss < bestV.miss) bestV = { side: g.side, left: g.left, top: t, miss, nudged };
					if (bestV.miss === 0) break;
				}
				const chosenV = bestV ?? { side: "below" as const, left: clampLeft(pet.x), top: clampTop(belowTop), miss: -1, nudged: false };
				write(chosenV.left, chosenV.top);
				return chosenV;
			}

			const pool = fitting.length
				? fitting // 放得下的一侧（右优先），再按遮挡筛
				: [right.room >= left.room ? right : left]; // 两侧都放不下 → 空间大的那侧兜底
			const geo = pool.map((c) => ({
				side: c.side,
				left: c.side === "right" ? Math.max(m, Math.min(Math.max(m, rightEdge - pw), c.raw)) : clampLeft(c.raw),
			}));
			let best: { side: "left" | "right"; left: number; top: number; miss: number } | null = null;
			// ③ 第一轮：对齐宠物顶部，逐个候选侧抽样；哪一侧干净就用它（被遮挡 → 换另一侧）
			for (const g of geo) {
				const r = sampleAt(g.left, aligned);
				if (best === null || r.miss < best.miss) best = { side: g.side, left: g.left, top: aligned, miss: r.miss };
				if (r.miss === 0) break;
			}
			// ④ 第二轮（两侧都被挡住）：纵向让开遮挡带 —— 挪到遮挡物下沿之外 / 上沿之外，最多 3 轮
			if (best && best.miss > 0) {
				for (const g of geo) {
					let t = aligned;
					let r = sampleAt(g.left, t);
					let misses = r.miss;
					for (let k = 0; k < 3 && r.miss > 0 && r.boxes.length; k++) {
						const down = clampTop(Math.max(...r.boxes.map((b) => b.bottom)) + 4);
						const up = clampTop(Math.min(...r.boxes.map((b) => b.top)) - 4 - ph);
						// 两个方向各抽一次，取更干净的那个（相同就保持不动，避免来回抖）
						let step: { t: number; miss: number } | null = null;
						for (const t2 of [down, up]) {
							if (t2 === t) continue;
							const r2 = sampleAt(g.left, t2);
							if (r2.miss < r.miss && (step === null || r2.miss < step.miss)) step = { t: t2, miss: r2.miss };
						}
						if (!step) break; // 两个方向都没变好 → 这一侧让不开
						t = step.t;
						r = sampleAt(g.left, t);
						misses = r.miss;
					}
					if (misses < best.miss) best = { side: g.side, left: g.left, top: t, miss: misses };
					if (best.miss === 0) break;
				}
			}
			// 兜底：pool 至少有一个候选，所以 best 一定有值（最坏情况就是"遮挡更少的那一侧"）
			const chosen = best ?? { side: "right" as const, left: clampLeft(pet.x + w + gap), top: aligned, miss: -1 };
			write(chosen.left, chosen.top);
			return { ...chosen, nudged: chosen.top !== aligned };
		}

		/**
		 * 按当前档位决定菜单里显示「落下去」还是「飘起来」（R-PET-08）
		 * ============================================================================
		 * 两个按钮都在 DOM 里（不是条件渲染）：切档只翻 `hidden`，不用重建节点。
		 * 悬浮/固定档 → 显示「落下去」（可以把宠物放回地面）；贴地档 → 显示「飘起来」
		 * （否则一旦落下去就再也回不到悬浮，发起人会陷进死路）。
		 * ⚠️ 显隐会改变菜单高度 → 尺寸缓存必须作废，否则 `placeMenu()` 会拿旧高度算摆位。
		 *
		 * R-PET-13：末项是**开合项**，文案与 `aria-pressed` 跟着 `pet.mini` 走
		 * （正常「缩小」/ 迷你「叫醒她」）。为什么让文案变：双击能恢复这件事**没有任何视觉提示**，
		 * 只留一个按钮会让人以为她真的没了；换文案等于把回程路写在菜单上。
		 * ⚠️ v1.69 改过一次**字面**：发起人看着菜单说「**关闭变成缩小，其他不变，就改个前端文字**」
		 *    —— 「关闭」这个名字从一开始就不准（她没有被关掉，只是变小了），改文案不动行为。
		 *    断言跟着改的是**字面**，不是口径。
		 */
		function syncMenuMode(): void {
			if (!menu) return;
			const ground = pet.mode === "ground";
			if (dropItem) dropItem.hidden = ground;
			if (riseItem) riseItem.hidden = !ground;
			if (miniItem) {
				miniItem.textContent = pet.mini ? "叫醒她" : "缩小";
				miniItem.setAttribute("aria-pressed", pet.mini ? "true" : "false");
			}
			menuW = 0;
			menuH = 0;
		}

		/** 菜单摆位（口径 = `placePanel()` 的"不上下兜底"那一支，R-PET-08 起未变） */
		function placeMenu(): void {
			if (!menu || menu.hidden) return;
			if (!menuW || !menuH) {
				menuW = menu.offsetWidth || 132;
				menuH = menu.offsetHeight || 200;
			}
			const p = placePanel(
				menu,
				{ w: menuW, h: menuH },
				{ gap: menuGap, margin: menuMargin, verticalFallback: false },
			);
			menu.dataset.petMenuSide = p.side;
			menu.dataset.petMenuOccluded = String(p.miss);
			menu.dataset.petMenuNudged = p.nudged ? "1" : "0";
		}

		/** 打开菜单：先按档位定好「落下去」/「飘起来」，显形（才量得到尺寸）再摆位 */
		function openMenu(): void {
			if (!menu) return;
			syncMenuMode();
			menu.hidden = false;
			placeMenu();
		}

		function closeMenu(): void {
			if (menu) menu.hidden = true;
		}

		/* ── 对话（P5：`enable:false` 走本地 mock，`enable:true` 走适配层）─────────
		   ⚠️ 这条路径**不再读 `petConfig.agent.enable`**（那是 P3 的遗留死配置）：
		      真正的开关是 `agentConfig.enable`，由 `askAemeath()` 在里面判（关掉时
		      **一个请求都不发**，直接回 mock）。气泡提示语也照这个分叉，但两边都不许
		      出现"服务/连接/后端"这类运维字样。
		   R-PET-11：开框 = 建面板（`buildChatPanel()`，历史按内存里的 `chatLog` 回填）
		      + 摆位（`placeChat()`）+ 自动聚焦输入框（焦点管理，别让用户再点一下）。 */
		function openChat(): void {
			chatOpen = true;
			clearChatRuntime(); // 上一次的计时器 / AbortController / 待续跑状态一律作废
			pet.walking = false;
			pet.busyUntil = 0;
			clearTimeout(stateTimer);
			if (pet.asleep) wake();
			setState("running");
			bubble.classList.add("is-chat");
			bubble.classList.add("is-pop");
			clearTimeout(sayTimer);
			buildChatPanel();
			placeChat();
			chatInput?.focus();
		}

		/**
		 * 开框时把面板**按 `chatLog` 重建**（R-PET-11）
		 * ============================================================================
		 * 为什么"每次开都重建"而不是"留着 DOM 只翻显隐"：`closeChat()` 有一条**冻结的
		 * 老口径** —— 关框之后 `#pet-bubble.textContent` 必须为空（R-AGT-04 的复位断言就
		 * 量的这个）。既然关框要清空，那"关框再开续上历史"就只剩一条干净的路：
		 * **历史留在内存数组里，DOM 按它重建**（单一事实来源，不会出现"DOM 多一条、数组没有"）。
		 * 面板结构（自上而下，也就是"历史在上、输入框在下"这条需求的落点）：
		 *   `.pet-chat-head`   常驻标题 + 「回到最新」（往回翻时才出现）+ 「清空对话」
		 *                        （**没有**关闭按钮：退出去靠 R-PET-14 的"点外面"与 Esc，见下）
		 *   `.pet-chat-log`    历史区（`role="log" aria-live="polite"`：新行会被读屏播报）
		 *     └ `.pet-chat-line…` 逐条；末尾是 `.pet-chat-thinking`（思考中指示）
		 *   `.pet-chat`        输入框 + 发送（**最后一个子节点**，见 CSS 的 sticky bottom）
		 */
		function buildChatPanel(): void {
			bubble.textContent = "";
			// 聊天时整块气泡从 `role="status"` 换成 `role="dialog"`：
			// `role=status` 是 aria-atomic 的隐式语义 —— 历史区一多，每次新增都会**重播整段
			// 聊天记录**（读屏体验灾难）。改成 dialog + 让 `.pet-chat-log` 自己 polite 播新增行。
			bubble.setAttribute("role", "dialog");
			bubble.setAttribute("aria-label", "和爱弥斯聊天");
			bubble.removeAttribute("aria-live");

			const head = document.createElement("div");
			head.className = "pet-chat-head";
			const title = document.createElement("span");
			title.className = "pet-chat-title";
			title.textContent = "和爱弥斯聊天";
			chatJump = document.createElement("button");
			chatJump.type = "button";
			chatJump.className = "pet-chat-jump";
			chatJump.textContent = "↓ 最新";
			chatJump.title = "跳到最新一句";
			chatJump.hidden = true;
			chatJump.addEventListener("click", () => scrollChatToBottom(true));
			const clear = document.createElement("button");
			clear.type = "button";
			clear.className = "pet-chat-clear";
			clear.textContent = "清空对话";
			clear.title = "清掉这次会话里看得见的聊天记录";
			clear.addEventListener("click", () => clearConversation());
			// ⚠️ 面板里**没有**关闭按钮（发起人 2026-10-08：先说"×"这个可以有，随后明确
			//    「**不加叉键，那个功能不要了**」）。所以"怎么退出去"这件事全部由
			//    R-PET-14 的**点外面关框**承担（Esc 与切页是另外两条老路径）——
			//    谁要再加这个按钮，先问过他，别"顺手补一个"。
			head.append(title, chatJump, clear);

			chatList = document.createElement("div");
			chatList.className = "pet-chat-log";
			chatList.setAttribute("role", "log");
			chatList.setAttribute("aria-live", "polite");
			chatList.setAttribute("aria-relevant", "additions");
			chatList.setAttribute("aria-label", "聊天记录");

			chatThink = document.createElement("div");
			chatThink.className = "pet-chat-thinking";
			chatThink.hidden = true;
			const dots = document.createElement("span");
			dots.className = "pet-chat-dots";
			dots.setAttribute("aria-hidden", "true");
			for (let i = 0; i < 3; i++) dots.appendChild(document.createElement("i"));
			chatThinkText = document.createElement("span");
			chatThinkText.className = "pet-chat-think-text";
			chatRecv = document.createElement("span");
			chatRecv.className = "pet-chat-recv";
			chatRecv.hidden = true;
			chatThink.append(dots, chatThinkText, chatRecv);
			chatList.appendChild(chatThink);

			const form = document.createElement("form");
			form.className = "pet-chat";
			chatInput = document.createElement("input");
			chatInput.type = "text";
			chatInput.maxLength = petConfig.agent.maxLength;
			chatInput.placeholder = "和爱弥斯说……";
			chatInput.setAttribute("aria-label", "对爱弥斯说的话");
			chatSend = document.createElement("button");
			chatSend.type = "submit";
			chatSend.textContent = "发送";
			form.append(chatInput, chatSend);
			bubble.append(head, chatList, form);

			// 历史回填（关框再开、切页之后再开都走这里 —— 见 `chatLog` 的注释）
			for (const line of chatLog) chatList.insertBefore(buildLine(line), chatThink);
			ensureEmptyHint();
			markLatestReply();
			setThinking(chatBusy);
			bubble.addEventListener("scroll", () => showJump(!chatNearBottom()), { passive: true });
			scrollChatToBottom(true);

			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const text = (chatInput?.value ?? "").trim();
				if (!text) return;
				// 请求还在飞：**不许静默吞掉**（P5 复核 D-9）。留着用户那句话（别清输入框，
				// 否则他刚打的字没了），并给一句可见反馈；这一轮落地后会再提醒他重发一次。
				if (chatBusy) {
					chatPendingRetry = true;
					if (chatSend) {
						chatSend.dataset.petBusy = "1";
						chatSend.setAttribute("aria-disabled", "true");
					}
					// ⚠️ 反馈要**追加**：提交第一句时思考指示已经在转了，任何"只在答复为空时写"
					//    的判断都会让反馈永远写不进去（写这段时实测踩到）。
					if (!chatLog.some((l) => l.role === "notice" && l.text === BUSY_HINT))
						addLine("notice", BUSY_HINT);
					return;
				}
				if (chatInput) chatInput.value = "";
				addLine("user", text); // 用户那句先进历史（R-PET-11：历史区就是"看得见的上下文"）
				histIdx = -1;
				// ⚠️ v1.91：**这里不许把 `lastReply` 覆盖成用户刚说的那句**。
				//    `lastReply` 的定义是"爱弥斯上一句"（1181 行：只有非 user 的行才写它），
				//    适配层拿它判"用户这句是不是在回答刚才的反问"—— 覆盖成用户自己的话之后，
				//    `classifyAsk()` 判的就不是那句反问、而是用户这句话，等于**永远判不出
				//    "后端在问哪一篇"**（旧代码靠 `isResumeWord` 的真值门槛侥幸还能跑通约定词那条路）。
				//    实测证据：`reports/_choice-ask-probe.mjs`（修前用户回「1」也被翻成「不提供」）。
				runAsk(text, chatResume);
			});
			// 键盘：Enter 发送走表单的隐式提交（原生行为，不用另写）；Esc 关框在 document 上。
			// ↑/↓ = 翻自己说过的话（R-PET-11 的附加优化：历史能滚了，键盘也该能翻）
			// ⚠️ 用局部 `const box = chatInput` 而不是直接引用闭包变量：后者是 `let`（可空），
			//    TS 在回调里会一直判"possibly null"（astro check 会红）。
			const box = chatInput;
			box.addEventListener("keydown", (e: KeyboardEvent) => {
				const mine = chatLog.filter((l) => l.role === "user");
				if (!mine.length) return;
				if (e.key === "ArrowUp" && (box.selectionStart ?? 0) === 0 && !box.value) {
					e.preventDefault();
					histIdx = histIdx < 0 ? mine.length - 1 : Math.max(0, histIdx - 1);
					box.value = mine[histIdx].text;
				} else if (e.key === "ArrowDown" && histIdx >= 0) {
					e.preventDefault();
					if (histIdx >= mine.length - 1) {
						histIdx = -1;
						box.value = "";
					} else {
						histIdx += 1;
						box.value = mine[histIdx].text;
					}
				}
			});
		}

		/**
		 * 摆聊天框（R-PET-11）：**复用 `placePanel()`**（与右键菜单同一份选边 + 遮挡抽样），
		 * 只多两条约束：
		 *   · `verticalFallback: true` —— 340px 的面板并排不了时改走宠物上下方（明确兜底）；
		 *   · `rightEdgeFor` —— 避开右下角的浮动按钮列（`#back-to-top-btn` / `.floating-controls-container`），
		 *     判据与 R-PET-05 给宠物留安全区时用的是同一批节点。
		 * ⚠️ 坐标：气泡在 `.pet` 里（`.pet` 有 `transform`，它就是包含块），
		 *    所以写样式时要减掉 `pet.x/pet.y`；抽样仍按视口坐标（`toLocal` 只作用于写样式）。
		 * ⚠️ 什么时候重排：开框、缩窗、滚动（浮动按钮会随滚动出现/消失）。**宠物飞行/浮动时不重排** ——
		 *    面板是"读东西的地方"，跟着宠物一呼一吸地漂会让字看不稳；拖动松手与飞行结束各补一次。
		 */
		/**
		 * 在这个纵向带上，"浮层右边最多能到哪"（px）——避开右下角的浮动按钮列。
		 * 节点与判据跟 R-PET-05 给宠物留安全区时用的是同一批（`#back-to-top-btn` /
		 * `.floating-controls-container`），只是这里换成"整块面板的右边界"。
		 */
		function floatFreeRight(top: number, ph: number): number {
			let limit = vw - menuMargin;
			for (const node of document.querySelectorAll<HTMLElement>(
				"#back-to-top-btn, .floating-controls-container",
			)) {
				const r = node.getBoundingClientRect();
				if (r.width === 0 || r.height === 0) continue;
				if (r.bottom < top || r.top > top + ph) continue; // 纵向不重叠 → 不挡
				limit = Math.min(limit, r.left - 12);
			}
			return limit;
		}

		function placeChat(): void {
			if (!chatOpen) return;
			const m = menuMargin;
			const gap = menuGap;
			let panelW = Math.min(CHAT.width, Math.max(CHAT.minWidth, vw - m * 2));
			let panelH = Math.min(CHAT.height, Math.max(CHAT.minHeight, vh - m * 2));
			// 两侧可用宽度：**与 `placePanel()` 的选边口径逐字一致**（宠物矩形到视口边，
			// 扣掉边距与间隙；右侧再避开浮动按钮列），否则"这里算够、那里算不够"会互相打架
			const roomRight = Math.min(vw - m, floatFreeRight(pet.y, panelH)) - (pet.x + w + gap);
			const roomLeft = pet.x - gap - m;
			const bestRoom = Math.max(roomRight, roomLeft);
			if (bestRoom < panelW && bestRoom >= CHAT.minWidth) {
				// ② 收窄：塞得进就**别翻上下** —— "出现在人物的左边或者右边"是发起人明确的偏好，
				//    宁可窄一点（340 → 可用宽度），也别把他要的方向换掉。留 2px 余量给边框取整。
				panelW = Math.max(CHAT.minWidth, Math.floor(bestRoom) - 2);
			} else if (bestRoom < CHAT.minWidth) {
				// ③ 上下兜底（明确兜底）：先把高度压到"宠物上方/下方真正剩多少" ——
				//    宁可矮（面板内部本来就能滚），也别把宠物本体整块盖住。
				//    ⚠️ 高度要按**两支里更紧的那一份**量：最后被选中哪一支不由这里决定 ——
				//       `placePanel()` 还会做遮挡抽样（620×700 实测：上方那一支被顶部导航栏挡住 →
				//       它自己翻到下方），只按其中一支量高，另一支就会因为放不下而被夹回来压住宠物
				//       （实测压了 2px）。两支都 ≥ `minHeight` 时取小的那份 → 选哪支都不压；
				//       都放不下（极端矮视口）才取大的那份，允许压一点，至少还读得到。
				const below = vh - m - (pet.y + h + gap);
				const above = pet.y - gap - m;
				const tight = Math.min(below, above);
				const room = tight >= CHAT.minHeight ? tight : Math.max(below, above);
				panelH = Math.max(CHAT.minHeight, Math.min(CHAT.height, room));
				panelW = Math.min(CHAT.width, vw - m * 2);
			}
			bubble.style.setProperty("--pet-chat-w", `${Math.round(panelW)}px`);
			bubble.style.setProperty("--pet-chat-h", `${Math.round(panelH)}px`);
			// 量真实盒子（宽高都可能被视口夹过），拿它去算摆位
			const box: PanelBox = { w: bubble.offsetWidth || panelW, h: bubble.offsetHeight || panelH };
			const p = placePanel(bubble, box, {
				gap,
				margin: m,
				verticalFallback: true,
				toLocal: (left, top) => ({ left: left - pet.x, top: top - pet.y }),
				rightEdgeFor: floatFreeRight,
			});
			bubble.dataset.petChatSide = p.side;
			bubble.dataset.petChatOccluded = String(p.miss);
			bubble.dataset.petChatNudged = p.nudged ? "1" : "0";
			bubble.dataset.petChatW = String(Math.round(box.w));
			bubble.dataset.petChatH = String(Math.round(box.h));
		}

		/**
		 * 「清空对话」（R-PET-11）：清历史 + 放掉后端那条线程。
		 * 为什么放在**面板头部**而不是输入框旁边：它是破坏性操作，离发送按钮越远越不容易误点，
		 * 而且不占输入行的宽度（输入框越宽越好打字）。
		 * 为什么顺带 `resetSession()`：清空之后后端还拿着上文会很怪（用户说"刚才那个"，它却还记得）。
		 */
		function clearConversation(): void {
			// 与关框同一条作废口径：掐掉在飞的这一轮，迟到结果不许再写进来
			chatSession++;
			chatAbort?.abort();
			chatAbort = null;
			chatBusy = false;
			chatPendingRetry = false;
			chatAsk = null;
			chatResume = null;
			lastReply = "";
			chatLog = [];
			clearLineNodes();
			setThinking(false);
			reEnableInput();
			resetSession();
			addLine("notice", CLEAR_NOTICE);
			setState("running");
		}

		function closeChat(): void {
			if (!chatOpen) return;
			chatOpen = false;
			clearChatRuntime(); // 关框 = 这一轮作废：掐流、清计时器、迟到结果不许再写气泡
			bubble.classList.remove("is-chat");
			bubble.classList.remove("is-pop");
			// 焦点还给宠物（R-PET-11：Esc 关框之后 Tab 不该从头开始找）
			if (bubble.contains(document.activeElement)) {
				try {
					hit?.focus({ preventScroll: true });
				} catch {
					/* 老浏览器不认 options：忽略 */
				}
			}
			bubble.textContent = ""; // 老口径：关框后气泡文本必须为空（R-AGT-04 的复位断言）
			bubble.removeAttribute("role");
			bubble.removeAttribute("aria-label");
			bubble.setAttribute("role", "status");
			bubble.setAttribute("aria-live", "polite");
			delete bubble.dataset.petChatState;
			delete bubble.dataset.petChatSide;
			delete bubble.dataset.petChatW;
			delete bubble.dataset.petChatH;
			chatList = null;
			chatThink = null;
			chatThinkText = null;
			chatRecv = null;
			chatInput = null;
			chatSend = null;
			chatJump = null;
			bubble.style.removeProperty("--pet-chat-w");
			bubble.style.removeProperty("--pet-chat-h");
			// ⚠️ **必须把摆位写的 inline left/top 也清掉**：台词气泡（`say()`）靠的是
			//    `.pet-bubble` 基类的 `left:50%; bottom: calc(100% - 20px); translate:-50% 0`
			//    贴在宠物头顶；残留的 inline `left/top`（聊天框那套视口坐标换算成 `.pet` 坐标系的值）
			//    会**压过基类**，于是关框之后第一句台词会出现在屏幕中间那块地方（错位）。
			bubble.style.removeProperty("left");
			bubble.style.removeProperty("top");
			setState("idle");
			pet.nextAt = performance.now() + 1200;
		}

		/* ── 位置记忆（R-PET-06 起连 y 一起存）──────────────
		   P3 只存 x（站着时 y 由地面决定）。悬浮 / 固定模式下 y 是有意义的，
		   不存的话刷新一次就跳回默认高度。所以改成 JSON `{x, y, mode}`；
		   旧格式（纯数字）仍能读。⚠️ `mode` 只是**记着**，
		   启动时模式一律以 `petConfig.movement.mode` 为准（配置优先级高于记忆）。 */
		function savePos(): void {
			if (!pet.userMoved) return;
			try {
				localStorage.setItem(
					PET_KEY,
					JSON.stringify({ x: Math.round(pet.x), y: Math.round(pet.y), mode: pet.mode }),
				);
			} catch {
				/* 隐私模式下 localStorage 会抛，忽略 */
			}
		}

		function loadPos(): { x: number; y: number | null; mode: PetMovementMode | null } | null {
			try {
				const raw = localStorage.getItem(PET_KEY);
				if (!raw) return null;
				if (raw.trim().startsWith("{")) {
					const o = JSON.parse(raw) as { x?: unknown; y?: unknown; mode?: unknown };
					const x = Number(o.x);
					if (!Number.isFinite(x)) return null;
					const y = Number(o.y);
					const m = o.mode;
					return {
						x,
						y: Number.isFinite(y) ? y : null,
						mode: m === "float" || m === "fixed" || m === "ground" ? m : null,
					};
				}
				// P3 的旧格式：一个整数 = 只有 x
				const v = Number.parseInt(raw, 10);
				return Number.isNaN(v) ? null : { x: v, y: null, mode: null };
			} catch {
				return null;
			}
		}

		/* ── 与站点其它部分的联动（R-PET-03）───────────────── */
		function markRoute(): void {
			const isPost = /^\/(posts|archive)\//.test(location.pathname);
			root.dataset.petRoute = isPost ? "post" : "page";
		}

		function hookInputs(): void {
			// 搜索框打字 → 进入「执行任务」的墨镜幽灵状态
			document.addEventListener(
				"input",
				(e) => {
					const t = e.target;
					if (!(t instanceof HTMLElement)) return;
					if (!t.closest("#search-bar, #search-bar-inside, #search-panel")) return;
					wake();
					if (pet.dragging || pet.airborne || chatOpen) return;
					pet.walking = false;
					pet.busyUntil = 0;
					setState("running");
					clearTimeout(workTimer);
					workTimer = window.setTimeout(() => {
						if (pet.state === "running") {
							setState("idle");
							pet.nextAt = performance.now() + 600;
						}
					}, workLinger);
				},
				true,
			);

			// 换主题 → 原地庆祝（模板 setTheme 会派发 theme-change）
			window.addEventListener("theme-change", () => {
				if (pet.dragging) return;
				const r = el?.getBoundingClientRect();
				if (r) spark(r.left + r.width / 2, r.top + r.height * 0.42, 8);
				setState("review", REVIEW_HOLD);
				pet.nextAt = performance.now() + 1300;
			});

			// 无操作超时 → 屏幕待机（判定通过后交给 doze()，与调试钩子共用同一段逻辑）
			window.setInterval(() => {
				// R-PET-13：迷你档不进待机画面 —— 她已经"很小一只"了，
				// 再切成电子幽灵待机图反而比现在更显眼（与"降存在感"的初衷相反）。
				if (pet.mini) return;
				if (pet.asleep || pet.dragging || pet.airborne || chatOpen) return;
				if (performance.now() - pet.lastActive < sleepAfter) return;
				doze();
			}, 3000);
		}

		/* ── 启动 ───────────────────────────────────────── */
		function boot(): void {
			measure();
			markRoute();

			// 模式：**配置优先**（R-PET-06）。位置记忆里的 mode 只用来判断"那份 y 还作不作数"，
			// 绝不用它覆盖 petConfig.movement.mode —— 否则改了配置却看不到变化。
			const saved = loadPos();
			pet.mode = MODE;
			el?.setAttribute("data-pet-mode", MODE);
			if (saved === null) {
				pet.x = defaultX();
			} else {
				pet.x = clampX(saved.x);
				pet.userMoved = true;
			}
			// y 的来路按模式分：贴地 → 地面；悬浮/固定 → 同一模式存下来的 y，否则用各自的默认落点
			if (MODE === "ground") {
				pet.y = floorY;
			} else if (saved && saved.mode === MODE && saved.y !== null) {
				pet.y = MODE === "float" ? clampAirY(saved.y) : clampY(saved.y);
			} else if (MODE === "fixed") {
				// ⚠️ v1.59（R-PET-06 默认档改 `fixed`）：**固定档的首访落点 = 右下角的地面线**
				// （与贴地档同一个落点）。改前它跟着悬浮档走 `floatBaseY()`（视口 52% 处），
				// 实测（`reports/_pet-fixed-landing-probe.mjs`，1440×900、全新 profile 无 localStorage）：
				// 宠物停在 (1228, 401) —— 正落在**视口纵向正中**，压住右栏组件
				// （「还没有发布动态」那段 5385px² + 两个 `.category-pill` 共 3712px²）。
				// 一个"完全静止"的宠物停在屏幕正中不合口径（本文件上面的注释自己写的是
				// "只想让它安静待在角落"），所以改成站在右下角地面线上：既是角落，
				// 又天然避开右下角浮动按钮列（x 仍由 `defaultX()` 的 `FLOAT_RESERVE` 预留，
				// 宠物右边缘 1352 距按钮列左边缘 1376 有 24px，实测间距见同一份报告）。
				pet.y = floorY;
			} else {
				pet.y = floatBaseY();
			}
			if (MODE === "float") {
				pet.hoverBase = pet.y;
				pet.hoverPhase = 0;
			}
			pet.lastActive = performance.now();
			pet.nextAt =
				MODE === "fixed"
					? Number.POSITIVE_INFINITY
					: performance.now() + (MODE === "float" ? nextFlyDelay() : 1800);

			sprite?.style.setProperty("--pet-face", "1");
			sprite?.style.setProperty("--pet-dy", "0px");
			sprite?.style.setProperty("--pet-tilt", "0deg");
			sprite?.style.setProperty("--pet-fly-scale", "1");
			setState("idle");
			// 把初始状态也写进 DOM：setState 在"状态没变"时会提前返回，
			// reduced-motion 下更是压根不调它，属性就一直是空的（验收脚本读不到）
			el?.setAttribute("data-pet-state", pet.state);
			el?.setAttribute("data-pet-frame-ms", String(Math.round(1000 / PET_STATES[pet.state].fps)));

			/* ── 调试钩子（`verify:ui` 的 R-PET-06 / R-PET-08 断言用）────────
			   调的是**和真实行为同一个函数**，不是旁路：
			     · `__imissFlyNow()` → `decide()` 里那次 `startFlight()`
			     · `__imissSetMode()` → `boot()` 里那次 `setMode()`
			     · `__imissSleepNow()` → 45 秒无操作巡检里那次 `doze()`（R-PET-08 新增）
			   为什么要它：飞行间隔最小 30 秒、睡着要等 45 秒，验收脚本不可能干等；
			   但仍要断言"飞了 / 没飞""睡着了"是真的发生了，而不是改属性骗自己。 */
			const dbg = window as Window & {
				__imissFlyNow?: () => boolean;
				__imissSetMode?: (m: PetMovementMode) => PetMovementMode;
				__imissSleepNow?: () => PetStateName;
				/** R-PET-13：「关闭」档的开合钩子（传 true = 关闭，false = 叫醒，不传 = 取反） */
				__imissMiniNow?: (on?: boolean) => boolean;
				__imissPetDebug?: () => {
					mode: PetMovementMode;
					x: number;
					y: number;
					flying: boolean;
					reduce: boolean;
					mini: boolean;
				};
				/** 对话状态探针（R-AGT-04 的断言用）：只读，返回当前快照，**不改任何行为** */
				__imissChatDebug?: () => {
					open: boolean;
					busy: boolean;
					ask: string | null;
					resume: string | null;
					/** 反问的类型（v1.91）：`choice` = 要序号/篇名（前端不许替答），`resume-word` = 三个约定词 */
					askKind: "resume-word" | "choice" | null;
					lastReply: string;
				};
			};
			dbg.__imissFlyNow = () => startFlight(performance.now(), true);
			dbg.__imissSetMode = (m) => {
				if (m !== "float" && m !== "fixed" && m !== "ground") return pet.mode;
				wake();
				setMode(m);
				return pet.mode;
			};
			// R-PET-08：「睡一会儿」菜单入口已删，`waiting` 只剩 45 秒无操作这条真实路径 ——
			// 验收脚本不可能干等 48 秒，所以给它一个调**同一段 `doze()`** 的钩子（不绕过状态转换）。
			dbg.__imissSleepNow = () => {
				doze();
				return pet.state;
			};
			// R-PET-13：「关闭」档（缩小成很小一只）的钩子。和上面几个同一个惯例 ——
			// 调的是**菜单末项与双击都走的那一个 `setMini()`**，不绕过行为、不直接改属性，
			// 所以断言验的是"真的缩了"（`measure()` 量出来的真实 offsetWidth）。
			dbg.__imissMiniNow = (on) => {
				setMini(on ?? !pet.mini);
				return pet.mini;
			};
			dbg.__imissPetDebug = () => ({
				mode: pet.mode,
				x: Math.round(pet.x),
				y: Math.round(pet.y),
				flying: pet.flight !== null,
				reduce,
				mini: pet.mini,
			});
			// R-AGT-04：把"待续跑"这条状态**只读地**暴露出来。
			// 为什么要它：`interrupt` 的续跑词是适配层按后端问句推出来的（`replyForAsk`），
			// 断言要验的是"组件真的会拿这个词去续跑"，而这个词只存在于闭包里 ——
			// 没有这个探针，脚本只能自己猜一个词，猜错了会变成"测试写错、代码背锅"。
			// 与 `__imissFlyNow` 那批同理：**只读不写**，不提供任何旁路。
			dbg.__imissChatDebug = () => ({
				open: chatOpen,
				busy: chatBusy,
				ask: chatAsk,
				resume: chatResume,
				// v1.91：反问的**类型**（只读事实）。断言靠它区分"该不该由前端替答"：
				// `choice` 那一类必须上屏等人答，`resume-word` 那一类才走约定词自动/手动续跑。
				askKind: chatAsk ? classifyAsk(chatAsk) : null,
				lastReply,
				// ── R-PET-11 新增（同样是**只读**事实，给"历史 / 思考中 / 上一次答复"
				//    这几条断言用）：`lines` = 历史条数、`thinking` = 思考指示是否在转、
				//    `received` = 思考中已收到的流式字数（**不含正文**，正文只在完成时上屏）、
				//    `answer` = 此刻 `.pet-chat-reply` 的正文（判"第 N 问显示的是不是第 N 答"）。
				lines: chatLog.length,
				thinking: !!chatThink && !chatThink.hidden,
				thinkLine: chatThinkText?.textContent ?? "",
				received: chatStreamBuf.length,
				answer: bubble.querySelector(".pet-chat-reply")?.textContent ?? "",
				// ── v1.37 新增：这一轮答复**是哪来的**（只读事实）。
				//    `"live"` = 真的从后端拿到的答复；`"fallback"` = 后端不可达/契约不符，
				//    气泡里是 `fallbackReply()` 的降级台词；`"mock"` = 配置关掉（`enable:false`）。
				//    为什么要暴露：发起人 2026-09-27 图证里"降级台词与真答复长得一模一样"，
				//    光看文本分不出来 —— 断言得有一个**不靠文本**的判据。
				source: bubble.dataset.petChatSource ?? "",
			});

			hit?.addEventListener("pointerdown", onPointerDown);
			hit?.addEventListener("pointermove", onPointerMove);
			hit?.addEventListener("pointerup", onPointerUp);
			hit?.addEventListener("pointercancel", onPointerUp);
			hit?.addEventListener("contextmenu", (e: Event) => {
				e.preventDefault();
				wake();
				// R-PET-07：不再拿鼠标坐标当锚点 —— 菜单一律贴在宠物旁边（见 placeMenu）
				openMenu();
			});
			// 键盘可达（R-PET-02；R-PET-09 保留，**没有**跟着菜单入口一起删）：
			//   发起人说"左键点击就能跳所以按键没有必要" —— 那个"按键"指的是右键菜单里的
			//   「跳一下」按钮，已经删了。键盘这条**故意保留**：宠物是 `role="button" tabindex="0"`，
			//   去掉 Enter 之后它会变成"Tab 能聚焦、按下去却毫无反应"的假按钮（WCAG 2.1.1 键盘可达），
			//   而 Enter 做的事和左键单击**完全一样**（跳 + 说一句），不构成第二套功能。
			//   若发起人坚持连键盘一起删，正确做法是同时去掉 tabindex/role（别留假按钮），要另行确认。
			hit?.addEventListener("keydown", (e: KeyboardEvent) => {
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					jump();
					say();
				} else if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
					e.preventDefault();
					walkTo(pet.x + (e.key === "ArrowLeft" ? -110 : 110), performance.now());
				} else if (e.key === "Escape") {
					closeChat();
					closeMenu();
				}
			});

			menu?.addEventListener("click", (e) => {
				const t = e.target;
				if (!(t instanceof HTMLElement)) return;
				const btn = t.closest<HTMLElement>("[data-pet-act]");
				if (!btn) return;
				closeMenu();
				wake();
				switch (btn.dataset.petAct) {
					// R-PET-13：「说句话」入口已按发起人要求删除（原话："把说句话交互删掉"）。
					// `say()` **不是死代码**：左键单击、键盘 Enter、切档应答、出场问候、
					// 双击恢复都还在调它，只是不再单独占一个菜单项（单击宠物本来就会说话）。
					// R-PET-08：「落下去」= 切到贴地档 + **真的掉下去**。
					// `setMode(mode, smooth=true)` 不瞬移：位置不动，交给 `startFall()` 起手、
					// 由 step() 里贴地档那段重力积分一路落到 `floorY`（与拖动松手同一条路径）。
					case "drop":
						setMode("ground", true);
						say("好，我落下去。");
						break;
					// R-PET-08：「飘起来」= 反向回悬浮档，同样不瞬移 ——
					// `setMode(mode, smooth=true)` 复用 `startFlight()` 的缓动插值竖直飘上悬浮基准线。
					case "rise":
						setMode("float", true);
						say("那我飘回去啦。");
						break;
					case "chat":
						openChat();
						break;
					// R-PET-13：「缩小」= 开合项（缩成很小一只 / 叫醒她）。v1.69 前这项写作「关闭」。
					// 它是**唯一**的菜单入口，但走的不是旁路 —— 与双击共用同一个 `setMini()`。
					case "mini":
						setMini(!pet.mini);
						say(pet.mini ? undefined : "那我先躲一会儿，双击我就回来。");
						break;
					// 「跟过来」（原 `walkTo(pet.cursorX …)`）与「睡一会儿」（原 `pet.asleep = true;
					// setState("waiting")`）两个入口已按发起人要求删除（R-PET-08，原话："这两个没有鸟用"）。
					// 两者都不是死代码，只是去掉了菜单入口：`walkTo()` 仍被键盘 ←/→ 与贴地档
					// decide() 调用；`waiting` 仍由 hookInputs 里 45 秒无操作超时触发。
					default:
						break;
				}
			});

			document.addEventListener("pointermove", onDocMove, { passive: true });
			/**
			 * 文档级的"点外面就关"（capture 阶段，R-PET-07 / R-PET-14）
			 * ============================================================================
			 * 两件事共用一个监听：**菜单**（R-PET-07 起的口径，一行没改）与**聊天框**
			 * （R-PET-14，发起人：「**点按非对话框或非角色之外任意处，对话框就关闭**」）。
			 *
			 * 聊天框为什么必须由"点外面"来关：`closeChat()` 的入口只有 Esc（手机没键盘）、
			 * Swup 切页与组件内部调用 —— 面板里只有「↓ 最新」与「清空对话」，**没有关闭按钮**，
			 * 手机上打开之后就出不去了。
			 *
			 * 判据里的两个"例外"都是发起人的口径，不是随手加的：
			 *   · `bubble.contains(t)` —— 面板自己（含输入框、历史、两个按钮、气泡本体）；
			 *   · `hit.contains(t)`   —— **角色本人**（点她=逗她玩，不关框）。
			 * ⚠️ 第二条例外**不能写成 `el.contains(t)`**：`#pet` 是包住气泡的祖先节点，
			 *    面板也在它里面 → 那样写等于"永远不关"（`el.contains` 恒真）。
			 *
			 * ⚠️ capture 阶段是**故意**的：它保证这个判断跑在"菜单项自己的 click 处理器"
			 *    之前。从菜单点「和爱弥斯聊天」时 `chatOpen` 还是 false → 这里空过 →
			 *    紧接着菜单的处理器才 `openChat()`，所以"开框那一下"不会被自己关掉。
			 *    （这也是为什么不能改成冒泡阶段：那时 chat 已经开了，点击会被当场判成"点外面"。）
			 */
			document.addEventListener(
				"click",
				(e) => {
					const t = e.target as Node | null;
					if (!t) return;
					if (menu && !menu.hidden && !menu.contains(t)) closeMenu();
					if (chatOpen && !bubble.contains(t) && !hit.contains(t)) closeChat();
				},
				true,
			);
			document.addEventListener(
				"keydown",
				(e) => {
					if (e.key === "Escape") {
						closeMenu();
						closeChat();
					}
				},
				true,
			);

			for (const ev of ["pointerdown", "keydown", "wheel", "touchstart"] as const) {
				window.addEventListener(ev, wake, { passive: true });
			}

			window.addEventListener(
				"resize",
				() => {
					measure();
					applyTransform();
					// 视口变了 → 菜单尺寸缓存（max-height 跟着 vh 走）与位置都要重算（R-PET-07）；
					// 聊天框同理（宽高都被视口夹，R-PET-11）
					menuW = 0;
					menuH = 0;
					placeMenu();
					placeChat();
				},
				{ passive: true },
			);

			// 滚动时菜单跟着宠物重排（宠物是 fixed，滚动不影响它，但菜单的位置是相对视口算的，
			// 页面滚动后若还留着旧 left/top，视觉上就会"飘"在别处 —— R-PET-07）。
			// R-PET-11：聊天框也要重排 —— 它有一条"避开右下角浮动按钮列"的约束，
			// 而那几个按钮是**滚下去才出现**的（与 R-PET-05 同一个坑）。
			window.addEventListener(
				"scroll",
				() => {
					placeMenu();
					placeChat();
				},
				{ passive: true, capture: true },
			);

			document.addEventListener("visibilitychange", () => {
				if (document.hidden) {
					stop();
					savePos();
				} else {
					start();
				}
			});
			window.addEventListener("pagehide", savePos);

			hookInputs();

			// 切页（Swup）：节点不重建，只打招呼 + 重新量尺寸 + 更新安静模式
			document.addEventListener("astro:page-load", () => {
				markRoute();
				measure();
				if (pet.dragging) return;
				closeChat();
				// R-PET-13：迷你档不挥手也不出声（切页不该把她叫醒），只把菜单贴回去
				if (pet.mini) {
					placeMenu();
					return;
				}
				setState("waving", 1600);
				pet.busyUntil = performance.now() + 1600;
				pet.nextAt = performance.now() + 2000;
				placeMenu(); // 菜单跟着宠物跨页常驻，切页后重新贴回宠物旁边（R-PET-07）
			});

			if (reduce) {
				// 减少动态：不跑循环，停在待机首帧；点击、菜单、对话仍然可用。
				// R-PET-06：悬浮模式在这一档退化成"**静态悬浮**"——停在悬浮基准线上，
				// 不上下浮动、也不飞行（flyBlocked），但依然不贴地。
				pet.frame = 0;
				if (sprite) sprite.style.backgroundPosition = "0% 0%";
				if (MODE === "float") {
					pet.hoverPhase = 0;
					pet.hoverBase = clampAirY(pet.y);
					pet.y = pet.hoverBase;
				}
				applyTransform();
			} else {
				start();
				// 出场：先打个招呼，再交给 decide()
				window.setTimeout(() => {
					if (chatOpen) return;
					setState("waving", 1900);
					pet.busyUntil = performance.now() + 1900;
					say(petConfig.greeting);
				}, 900);
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot, { once: true });
		} else {
			boot();
		}
