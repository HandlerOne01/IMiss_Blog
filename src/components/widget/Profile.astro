---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

/*
 * 资料卡头像的悬停反馈：**只留一层轻微压暗，不再浮图标**
 * ============================================================================
 * v1.64（2026-10-07）按发起人要求去掉：他指着侧栏头像截图问
 * 「鼠标光标放这后这个图片图标能不能不显示？」—— 原本 `group-hover` 时会在头像正中
 * 淡入一枚 `fa7-regular:address-card`（名片）图标，观感像"点这里可以换图"，
 * 而这里其实只是通往 `/about/` 的链接。
 *
 * 保留的部分：压暗层（`group-hover:bg-black/30` / 按下 `bg-black/50`）与 `active:scale-95`。
 * 头像是个链接，把反馈全删掉访客就不知道它可点了。
 *
 * ⚠️ 这段说明写在 **frontmatter** 里而不是模板里：模板里的 `<!-- -->` 会**原样进产物**
 *    （ARCH.md §14.3 **T85**）—— 本轮第一版就写在模板里，`dist/index.html` 里真的多出两处
 *    含 `address-card` 的注释（浅/深两套侧栏各一份），已改到这边。
 * ⚠️ 压暗层带 `profile-avatar-veil` 这个 class 是**给断言用的钩子**（`verify:ui` 的
 *    R-WDG-04 会先量"那里没有 svg、没有子元素"，再用真鼠标悬停确认"底色确实变深了"）。
 */
interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="profile-avatar-veil absolute transition pointer-events-none group-hover:bg-black/30
        group-active:bg-black/50 w-full h-full z-50"
    >
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>
