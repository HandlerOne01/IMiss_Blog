---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];

		totalWords += chineseChars.length + englishChars.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// IMiss Blog（R-WDG-01）：原来这里还有「运行时长」与「最后活动」两项，
// 已按需求删除。顺带删掉了只服务这两项的 getActivityDate / lastActivityDate /
// lastPostDate / todayText，以及文件末尾那段内联 script ——
// ⚠️ 这里不许写出那个标签的字面量（尖括号 + script）：Vite 8 的依赖预打包扫描器会把 .astro
// 注释里的它当成真脚本块开始标记、把后面这串中文当 JS 解析 → PARSE_ERROR → 跳过预打包 →
// dev 模块请求卡到 60 秒超时（2026-10-08 实测，ARCH.md §14.3 T89）。
// 那段脚本靠 data-stat-id="running-days" / "last-update" 两个字符串字面量定位 DOM，
// 只删数组不删脚本会留下死代码，只删脚本不删数组则页面会一直显示初始值 0，两边必须一起删。
// 相关的 i18n key（siteStatsRunningDays / siteStatsLastUpdate / siteStatsDaysAgo）
// 保留在语言包里未删，避免动到上游的翻译文件。
const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-(--primary) text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          {/* R-WDG-01：原来这里还有 data-stat-id（供客户端脚本定位「运行时长/最后活动」两项）
              与 suffix（「天/天前」后缀），两项统计删除后一起清理掉了 */}
          <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
        </div>
      </div>
    ))}
  </div>
</WidgetLayout>

