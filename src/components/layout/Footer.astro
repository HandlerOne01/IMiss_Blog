---
import fs from "node:fs";
import path from "node:path";
import { profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

// ── P4-8（v1.47）：页脚署名从 "Powered by Astro & Firefly" 改成只留 "Powered by Astro" ──
// 删掉的是指向 github.com/CuteLeaf/Firefly 的那条外链（发起人要求站上不留任何上游品牌字样）。
// 上游源码此处原有注释写着"请勿随意修改或删除"；发起人已知情并明确拍板删除，
// 对上游的署名义务由仓库根目录的 LICENSE（MIT，保留原作者版权声明）承担 —— 页脚署名不是法律要求。
//
// ⚠️⚠️ 这段解释**必须留在 frontmatter 里，不能写成模板里的 HTML 注释**：
//   Astro 会把模板中的 `<!-- … -->` **原样打进 dist/*.html**（实测：写成 HTML 注释时，
//   `Footer.astro` 会出现在全站 162 个 HTML 里，于是"解释为什么删掉 Firefly"的那段话
//   自己把 "Firefly" / "CuteLeaf" 又发了一遍 —— 这正是本轮要消灭的字符串）。
//   本文件下面还有一条既有的模板 HTML 注释（site-footer 选择器那条），它不含敏感字样、保持原样。
//   同类坑：`SiteInfo.astro` 的解释写在 frontmatter，不随产物发布，是正确做法。
const currentYear = new Date().getFullYear();

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs.readFileSync(footerHtmlPath, "utf-8");
	// 移除HTML注释
	customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
} catch (error) {
	console.warn(
		"FooterConfig.html 读取失败:",
		error instanceof Error ? error.message : String(error),
	);
}
---

<!-- 页脚：普通流位于文档末尾。site-footer 是 immersive-reading 的隐藏选择器，
     pointer-events-auto 用于覆盖首页 banner 下父级的 pointer-events: none，两者勿删 -->
<footer class="site-footer pointer-events-auto pb-4 md:pb-6">
	<div
		class="transition border-t border-black/10 dark:border-white/15 mt-10 mb-5 border-dashed mx-32"
	>
	</div>

	<div class="transition flex flex-col items-center justify-center px-6">
		<div class="transition text-50 text-sm text-center wrap">
			<div class="mb-2">
				{customFooterHtml && <div set:html={customFooterHtml} />}
			</div>
			<div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
				&copy; <span id="copyright-year">{currentYear}</span>
				{profileConfig.name}. All Rights Reserved.
				{/* IMiss Blog（R-ID-06）：订阅（RSS / Atom）功能已整体移除，这里的两个链接一并删掉；
				    只保留 Sitemap。要恢复订阅见 ARCH.md §14.4 的说明（需要找回 4 个上游文件）。 */}
				<span aria-hidden="true">/</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href={url("sitemap-index.xml")}>Sitemap</a
				>
			</div>
			<!-- 署名：上游品牌外链已于 P4-8 移除，理由见本文件 frontmatter 的注释 -->
			<div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
				<span>Powered by</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href="https://astro.build">Astro</a
				>
			</div>
		</div>
	</div>
</footer>
