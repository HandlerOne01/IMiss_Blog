---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import ScrollDownIndicator from "@/components/controls/ScrollDownIndicator.astro";
import BackgroundPlayer from "@/components/features/BackgroundPlayer.astro";
import BannerHomeTextOverlay from "@/components/layout/BannerHomeTextOverlay.astro";
import BannerPostMetaOverlay from "@/components/layout/BannerPostMetaOverlay.astro";
import { backgroundWallpaper } from "@/config";
import "@/styles/wallpaper-video.css";
import type {
	BannerPostMeta,
	BannerVisibilityState,
} from "@/utils/banner-visibility-utils";
import type { BackgroundImages } from "@/utils/layout-utils";

interface Props {
	state: BannerVisibilityState;
	backgroundImages: BackgroundImages;
	title?: string;
	bannerPostMeta?: BannerPostMeta;
}

/**
 * 壁纸专用图片质量（R-BG-01）：
 * 首屏最大的一张图，发起人明确反馈"压缩到发糊不可以"，所以这里不走 siteConfig.imageQuality(85)，
 * 单独提到 95。代价是壁纸变体文件更大（原图直出 → 只压这一道）。
 */
const WALLPAPER_QUALITY = 95;

const { state, backgroundImages, title, bannerPostMeta } = Astro.props;
const wallpaperPosition = state.isFullscreenMode
	? (backgroundWallpaper.fullscreen?.position ??
		backgroundWallpaper.banner?.position)
	: backgroundWallpaper.banner?.position;

/**
 * 手动换壁纸（R-BG-05，本站新增）：桌面两侧隐藏交互区（hover / Tab 聚焦才淡出箭头）；
 * 鼠标与触屏按住横向拖动超过阈值就换图（同一套 pointer 手势，复用下面脚本里的 changeToSlide()：
 * 循环、懒实例化、淡入过渡、防连点都已处理好，这段只把用户意图翻译成 ±1）。
 * 脚本必须在这里拼成字符串（内联 script 标签里的插值不会被 Astro 求值，见 ARCH §14.3 T28）。
 * ⚠️ 这段说明里**不许写出那个标签的字面量**（尖括号 + script）：Vite 8 的依赖预打包扫描器
 * 会把 .astro 注释里的它当成真脚本块开始标记、把后面这串中文当 JS 解析 → PARSE_ERROR →
 * 整轮 `Skipping dependency pre-bundling` → dev 的模块请求卡到 60 秒超时
 * （2026-10-08 实测，ARCH.md §14.3 T89）。
 */
/* ── 动态壁纸（R-BG-06 / R-BG-07，v1.70；v1.105 增到 6 支 + 按时段选）─────
   壁纸现在是一段 <video>：发起人 2026-10-09 交来 5 个原画 mp4（**v1.105 增到 6 支**），要求
   「动态壁纸替换掉原有的静态图片」「首尾帧要能无限循环」「能不裁就不裁，要裁时人物在展示中心
   （手机端脸必须全露）」「全屏展示完整的动态壁纸」「不可压缩，我要原画」。
   v1.105（2026-10-10）再加两条：**把「起床」添进来、把「星夜」换掉**，以及
   **六个时段按北京时间选首屏默认素材**（下面 `pickFirst()` / `pickByTime()` 就是那件事）。
   逐条怎么落的见 `src/config/backgroundWallpaper.ts` 的 `video` 注释与 ARCH §6.5 / §7.8。 */
const videoConf = backgroundWallpaper.video;
const videoItems = videoConf?.enable ? (videoConf.playlist ?? []) : [];
const videoOn = videoItems.length > 0;
/** 首个（也是 `order: "first"` 时实际会显示的那个）：markup 里直接写进 <video>，浏览器第一帧就开始拉流 */
const videoFirst = videoItems[0];
/**
 * 内联脚本只用这几个字段 —— 整份配置塞进去没有意义，还会把 focus 之外的实现细节漏进产物。
 * ⚠️ 这段必须**在 frontmatter 里拼成字符串**再 set:html：内联标签体里的 `{表达式}`
 *    不会被 Astro 求值（ARCH §14.3 T28）。
 */
const videoData = {
	items: videoItems.map((it) => ({
		src: it.src,
		poster: it.poster,
		name: it.name,
		fx: it.focus.x,
		fy: it.focus.y,
		anchorY: it.focusAnchorY ?? 0.45,
		anchorX: it.focusAnchorX ?? 0.5,
		zoom: it.zoom ?? 1,
		// ⚠️ v1.105：`order: "time"` 要按这一项挑素材，所以**时段必须进产物**
		//    （原来只在配置对象里，内联脚本拿不到）。没写 `timeRange` 的就是 `null`。
		tr: it.timeRange ?? null,
	})),
	order: videoConf?.order ?? "first",
	fits: {
		banner: videoConf?.bannerFit ?? "cover",
		fullscreen: videoConf?.fullscreenFit ?? "contain",
	},
	respectReducedMotion: videoConf?.respectReducedMotion !== false,
	fadeMs: Number(videoConf?.fadeMs ?? 260),
	// ── 视频轮播（R-BG-09，v1.118）：间隔与"访客开关"的三个事实 ──────────────
	// 开关**复用面板那个**（显示设置面板 → 壁纸 → 壁纸轮播），所以这里只搬三个值：
	// 能不能由访客切换、默认关还是默认开（= common.carousel.enable，本站 false）、
	// 以及视频自己的间隔（v1.119 起 30 秒；图片那套 5 秒对原画太凶）。夹到 ≥5000 防误配。
	carouselInterval: Math.max(5000, Number(videoConf?.carousel?.interval ?? 30000)),
	carouselSwitchable: state.bannerCarouselSwitchable === true,
	carouselDefault: state.bannerCarouselEnabledDefault === true,
};
const videoScript = `(function initVideoWallpaper() {
	var DATA = ${JSON.stringify(videoData)};
	var layer = document.getElementById("wallpaper-video-layer");
	var video = document.getElementById("wallpaper-video");
	if (!layer || !video || !DATA.items.length) return;
	var root = document.documentElement;
	var idx = 0;

	function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
	function mode() { return root.dataset.wallpaperMode || "banner"; }
	function currentItem() { return DATA.items[idx]; }

	/**
	 * 按**当前框的宽高比**反算 object-position，把人物锚点顶到框里该在的位置。
	 * 为什么不能把 object-position 写死在 CSS 里：同一个视频要喂给四种框 ——
	 * 手机横幅 390×549（0.71:1，横向只剩三成宽）、桌面首页横幅 1440×720（2:1，横向裁 15%）、
	 * 非首页横幅 1440×495（2.9:1，改成纵向裁）、全屏（1.6:1，contain 不裁）。
	 * 一个百分比不可能同时对上四者，所以每换一次框就算一次。
	 */
	function applyFit() {
		var it = currentItem();
		var r = layer.getBoundingClientRect();
		var cw = r.width, ch = r.height;
		var iw = video.videoWidth, ih = video.videoHeight;
		if (!iw || !ih || !cw || !ch) return;
		var fit = DATA.fits[mode()] || "cover";
		video.style.objectFit = fit;
		layer.dataset.fit = fit;
		if (fit !== "cover") {
			video.style.objectPosition = "50% 50%";
			layer.dataset.objectPosition = "50% 50%";
			layer.dataset.visibleW = String(iw);
			layer.dataset.visibleH = String(ih);
			layer.dataset.focusX = String(it.fx);
			layer.dataset.focusY = String(it.fy);
			layer.dataset.anchorX = String(it.anchorX || 0.5);
			layer.dataset.anchorY = String(it.anchorY);
			layer.dataset.zoom = String(it.zoom || 1);
			return;
		}
		// zoom：手机端整幅高度全可见、垂直方向没有余量，想让人物"下沉"只能放大（见类型注释）
		var s = Math.max(cw / iw, ch / ih) * (it.zoom || 1);
		var visW = Math.min(iw, cw / s);
		var visH = Math.min(ih, ch / s);
		var left = clamp(it.fx * iw - visW * (it.anchorX || 0.5), 0, Math.max(0, iw - visW));
		var top = clamp(it.fy * ih - visH * it.anchorY, 0, Math.max(0, ih - visH));
		var px = iw > visW ? (left / (iw - visW)) * 100 : 50;
		var py = ih > visH ? (top / (ih - visH)) * 100 : 50;
		var pos = px.toFixed(2) + "% " + py.toFixed(2) + "%";
		video.style.objectPosition = pos;
		// 这几条 dataset 是**给验收脚本读的事实**：不写出来，"人物在展示中心"就只能靠肉眼
		layer.dataset.objectPosition = pos;
		layer.dataset.focusX = String(it.fx);
		layer.dataset.focusY = String(it.fy);
		layer.dataset.anchorX = String(it.anchorX || 0.5);
		layer.dataset.anchorY = String(it.anchorY);
		layer.dataset.zoom = String(it.zoom || 1);
		layer.dataset.visibleW = String(Math.round(visW));
		layer.dataset.visibleH = String(Math.round(visH));
		layer.dataset.focusAtX = String(Math.round((left + visW / 2) / iw * 1000) / 10);
		layer.dataset.focusAtY = String(Math.round((top + visH * it.anchorY) / ih * 1000) / 10);
	}

	/** 播（或被策略/浏览器拦下）。拦下不是错误：海报帧会一直显示 */
	function pump() {
		// 降级一：系统偏好减少动态（R-BG-02 的第 1 种）
		var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (DATA.respectReducedMotion && reduce) {
			layer.dataset.playing = "0";
			layer.dataset.playReason = "reduced-motion";
			try { video.pause(); } catch (e) {}
			return;
		}
		// 降级二：省流量模式（R-BG-02 的第 2 种）。原画一支 8~13.5 MB，用户开了省流量就别自动下。
		// 用 navigator.connection.saveData（Chrome/Edge/安卓 Chrome 支持；不支持的浏览器读不到，等于不降级）
		var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
		if (conn && conn.saveData) {
			layer.dataset.playing = "0";
			layer.dataset.playReason = "save-data";
			try { video.pause(); } catch (e) {}
			return;
		}
		// 降级三：页面切到后台（第 3 种）——由下面的 visibilitychange 负责，这里只管"前台该播"
		if (document.hidden) {
			layer.dataset.playing = "0";
			layer.dataset.playReason = "hidden";
			try { video.pause(); } catch (e) {}
			return;
		}
		layer.dataset.playReason = "";
		var p = video.play();
		if (p && p.catch) p.catch(function () { layer.dataset.playing = "0"; layer.dataset.playReason = "autoplay-blocked"; });
	}
	video.addEventListener("playing", function () { layer.dataset.playing = "1"; layer.dataset.playReason = ""; });
	video.addEventListener("loadedmetadata", applyFit);
	video.addEventListener("loadeddata", function () { layer.dataset.ready = "1"; });

	function syncFacts() {
		var it = currentItem();
		root.dataset.wallpaperIndex = String(idx);
		root.dataset.wallpaperCount = String(DATA.items.length);
		root.dataset.wallpaperSrc = it.src;
		// ⚠️ 这里的反斜杠要写**两层**：这段代码是拼在模板字符串里产出的，两个反斜杠加斜杠求值后
		//    才是「反斜杠 + 斜杠」。写成单层会被字符串吃掉，产物里变成提前闭合的正则 + 浏览器里
		//    一个 SyntaxError（本轮踩到）。同理 .mp4 那个点的反斜杠也要写两层，否则「点」会变成
		//    「任意字符」—— 那条不报错，只是悄悄换了语义。
		layer.dataset.slug = it.src.replace(/^.*\\//, "").replace(/\\.mp4$/, "");
		layer.dataset.name = it.name;
		layer.dataset.index = String(idx);
	}

	/** 换一张（dir = ±1 或绝对下标由 step/call 决定）；animate=false 只用于初始化 */
	function load(i, animate) {
		var next = (i + DATA.items.length) % DATA.items.length;
		if (next === idx && layer.dataset.ready === "1") return;
		idx = next;
		syncFacts();
		var it = currentItem();
		var paint = function () {
			video.poster = it.poster;
			video.src = it.src;
			video.load();
			applyFit();
			pump();
		};
		var back = document.querySelector(".wallpaper-video-letterbox");
		if (back) back.style.backgroundImage = "url(" + it.poster + ")";
		if (animate && DATA.fadeMs > 0) {
			layer.style.setProperty("--wp-video-fade", DATA.fadeMs + "ms");
			layer.classList.add("is-fading");
			window.setTimeout(function () { paint(); layer.classList.remove("is-fading"); }, DATA.fadeMs);
		} else {
			paint();
		}
	}

	/**
	 * 进站放哪一个（R-BG-06 / P3-10，v1.105 落地 order: "time"）。
	 * ============================================================================
	 * 发起人 2026-10-10 亲口排的六档（北京时间）：
	 *   23–03 星夜｜03–07 起床｜07–11 洗手台｜11–15 湖畔｜15–19 窗边｜19–23 塔罗
	 *
	 * **为什么在客户端算而不是构建期注入**：这是个纯静态站，构建期只能定"构建那一刻"
	 * 的小时，产物发出去之后就不再变 —— 而发起人要的是"**访客打开时**该看哪一支"。
	 * 所以判定放在这里（进站一次），口径是**访客打开那一刻的北京时间**。
	 *
	 * ⚠️ 这段是拼在**模板字符串**里产出的：注释里**不能出现反引号**（会提前闭合字符串，
	 *    报一堆 ts(1005) —— 同 §14.3 T94 那一族）。所以下面提到代码时一律不加反引号。
	 *
	 * **为什么不用 new Date().getHours()**：那读的是**访客本机时区**。发起人没给例外，
	 * 所以按 UTC+8 换算 —— Date.now() 是 UTC 毫秒数，加 8 小时再取 getUTC* 就是北京时间，
	 * 与访客把系统时区设成什么无关（纽约访客看到的也是"此刻北京几点"该有的那一支）。
	 *
	 * 区间判定（与配置注释、类型注释三处同一口径）：
	 *   · **左闭右开 [start, end)** → 边界整点归后者（03:00 整算「起床」）；
	 *   · **start > end = 跨零点** → 用「≥ start 或 < end」判，不然这一档永远不命中。
	 */
	function toMinutes(hhmm) {
		// ⚠️ 反斜杠必须写**两层**（写成两个反斜杠 + d）：这段代码是拼在**模板字符串**里产出的，
		//    单层的反斜杠会被字符串吃掉，产物里那个正则变成「d 花括号」—— 一个永远不匹配的
		//    正则 → 六档全部解析失败 → **静默**退回第 0 项（不报错、页面照常显示，只是永远
		//    放错那一支）。**本轮真踩到了**（reports/_v1105-live-pick.mjs 在真时钟下抓到：
		//    北京 03:10 该播起床，页面却放了窗边少女），与上面 dataset.slug 那两处同一个病因。
		//    ⚠️ 同一段里**也不许写反引号**（注释里也不行）—— 会提前闭合模板字符串、直接编译报错。
		var m = /^(\\d{1,2}):(\\d{2})$/.exec(String(hhmm || ""));
		if (!m) return null;
		var h = Number(m[1]);
		var mi = Number(m[2]);
		if (h > 23 || mi > 59) return null;
		return h * 60 + mi;
	}
	/** 当前北京时间的一天内分钟数（0~1439） */
	function beijingMinutes() {
		var bj = new Date(Date.now() + 8 * 3600000);
		return bj.getUTCHours() * 60 + bj.getUTCMinutes();
	}
	function pickByTime() {
		var now = beijingMinutes();
		for (var i = 0; i < DATA.items.length; i++) {
			var tr = DATA.items[i].tr;
			if (!tr) continue;
			var a = toMinutes(tr[0]);
			var b = toMinutes(tr[1]);
			if (a === null || b === null || a === b) continue;
			// 左闭右开；a > b 说明这一段跨零点
			if (a < b ? (now >= a && now < b) : (now >= a || now < b)) return i;
		}
		// 兜底：没有任何一项命中（正常配置下六档铺满 24 小时，走不到这里）
		return 0;
	}
	function pickFirst() {
		if (DATA.order === "random") return Math.floor(Math.random() * DATA.items.length);
		if (DATA.order === "sequence") return Math.floor(Date.now() / 86400000) % DATA.items.length;
		if (DATA.order === "time") return pickByTime();
		return 0;
	}

	// 初始化：markup 里已经把第一项写进 <video> 了，这里只补事实/取景/播放策略
	idx = pickFirst();
	syncFacts();
	layer.dataset.ready = layer.dataset.ready || "0";
	applyFit();
	pump();
	if (idx !== 0) load(idx, false);

	// 给"手动换壁纸"（两侧箭头 / 拖动）用的入口：与轮播那套 __imissChangeToSlide 同构
	window.__imissWallpaperVideo = {
		count: DATA.items.length,
		current: function () { return idx; },
		// R-BG-09：手动换片要把轮播的表**重置**（否则刚手动换完，可能马上又被定时器换走）
		step: function (dir) { load(idx + dir, true); carStart(); return idx; },
		items: DATA.items.map(function (x) { return x.name; }),
		// ⚠️ v1.105：把**实际生效**的排序口径与每支的时段挂出来 —— 验收脚本据此断言
		//    "六档铺满 24 小时、不重不漏"（R-BG-06）。**别从产物 HTML 里正则抠 DATA**：
		//    构建链路的 minify-inline-scripts.ts 会把 var DATA 改名，读法会随压缩器漂。
		order: DATA.order,
		slots: DATA.items.map(function (x) { return x.tr ? [x.tr[0], x.tr[1]] : null; }),
	};
	/** 给验收用：把"北京时间的分钟数"直接喂进真实的那套匹配逻辑（不复制一份判据） */
	window.__imissWallpaperPickAt = function (minutes) {
		var now = Number(minutes);
		for (var i = 0; i < DATA.items.length; i++) {
			var tr = DATA.items[i].tr;
			if (!tr) continue;
			var a = toMinutes(tr[0]);
			var b = toMinutes(tr[1]);
			if (a === null || b === null || a === b) continue;
			if (a < b ? (now >= a && now < b) : (now >= a || now < b)) return i;
		}
		return 0;
	};

	/* ============================================================================
	 * 视频轮播（R-BG-09，v1.118）—— 六支原画按固定间隔自动换片。
	 *
	 * 发起人 2026-10-12 定的参数：**间隔 30 秒 / 默认关 / 桌面与手机都轮**
	 * （先定 60 秒，v1.119 他改口「**改成30s切换下一张吧**」→ 30 秒）。
	 *
	 * **开关复用访客那个**（显示设置面板 →「壁纸」页签 →「壁纸轮播」）：默认值取
	 * common.carousel.enable（本站 false），访客点过之后以 localStorage 里的值为准 ——
	 * 也就是说面板那个开关以前只对"图片幻灯片"有效（视频模式下没有幻灯片，点了没反应），
	 * 现在它对视频也生效了。
	 *
	 * **三种情况不轮**（与视频播放同一套判据，都是省流量/无障碍的理由）：
	 *   ① document.hidden（切到后台）② prefers-reduced-motion ③ navigator.connection.saveData
	 * 另外只在 **banner / 全屏 / 覆盖** 三种模式轮 —— 纯色模式没有壁纸，轮了也看不见。
	 *
	 * ⚠️ 这段是拼在**模板字符串**里产出的：注释里**不能出现反引号**（会提前闭合，T94）。
	 * ========================================================================== */
	var carTimer = null;
	var carStarts = 0;
	// 表真正"响"过几次 —— 验收脚本靠它判"每次只前进 1 格、且绕回第 1 支"。
	// ⚠️ 为什么要有这个计数：验收侧按时间采样（每 0.33 秒看一眼），而定时器是 0.3 秒一跳，
	//    两者一错位就会"两次跳只采到一次"，采样序列看着像跳号（v1.118 第一版断言就因此假红）。
	//    正确判据是"**索引前进量 == 跳的次数**"，与采样节奏无关。
	var carTicks = 0;

	function carouselEnabled() {
		if (!DATA.carouselSwitchable) return DATA.carouselDefault;
		var stored = null;
		try { stored = localStorage.getItem("bannerCarouselEnabled"); } catch (e) { stored = null; }
		if (stored === null) return DATA.carouselDefault;
		return stored === "true";
	}
	function carouselAllowedHere() {
		var m = mode();
		if (m !== "banner" && m !== "fullscreen" && m !== "overlay") return false;
		if (document.hidden) return false;
		if (DATA.respectReducedMotion && window.matchMedia &&
			window.matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
